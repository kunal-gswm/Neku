<Window x:Class="DesktopPet.UI.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="620"
        SizeToContent="Height"
        AutomationProperties.Name="Neku Command Palette"
        FocusManager.FocusedElement="{Binding ElementName=SearchInputBox}"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProductivityTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

            <Style x:Key="PaletteListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="Margin" Value="6,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ThemeSelectionHoverBrush}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource ThemeBorderSubtleBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ThemeSelectionBrush}"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentPurpleBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource ThemeCardBgBrush}"
            BorderBrush="{StaticResource ThemeInputBorderFocusedBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Search Box Header -->
            <Grid Grid.Row="0" Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="🔍"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource ThemeTextMutedBrush}"/>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="SearchInputBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource ThemeTextPrimaryBrush}"
                             CaretBrush="{StaticResource ThemeAccentPurpleBrush}"
                             FontSize="15"
                             FontFamily="Segoe UI"
                             FontWeight="Normal"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Command Search Input"
                             TextChanged="SearchInputBox_TextChanged"
                             PreviewKeyDown="SearchInputBox_PreviewKeyDown"/>

                    <TextBlock x:Name="PlaceholderText"
                               Text="Type a command or search (e.g. tasks, focus, notes, companion)..."
                               FontSize="14"
                               Foreground="{StaticResource ThemeTextMutedBrush}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0"/>
                </Grid>

                <Border Grid.Column="2"
                        Background="{StaticResource ThemeSurfaceBrush}"
                        BorderBrush="{StaticResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="ESC"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ThemeTextDimBrush}"/>
                </Border>
            </Grid>

            <!-- Divider -->
            <Border Grid.Row="1" Height="1" Background="{StaticResource ThemeBorderBrush}"/>

            <!-- 2. Results List & Empty State -->
            <Grid Grid.Row="2" MinHeight="160" MaxHeight="380">
                <ListBox x:Name="ResultsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource PaletteListBoxItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionMode="Single"
                         PreviewKeyDown="ResultsListBox_PreviewKeyDown"
                         MouseLeftButtonUp="ResultsListBox_MouseLeftButtonUp"
                         AutomationProperties.Name="Command Search Results">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="26" Height="26"
                                        Background="{StaticResource ThemeSurfaceBrush}"
                                        CornerRadius="5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Title and Description -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ThemeTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="{StaticResource ThemeTextDimBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Category Badge & Shortcut Hint -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource ThemeElevatedBrush}"
                                            BorderBrush="{StaticResource ThemeBorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
                                    </Border>

                                    <!-- Shortcut Pill (Only if present) -->
                                    <Border Background="{StaticResource ThemeInputBgBrush}"
                                            BorderBrush="{StaticResource ThemeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasShortcutHint, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="{Binding ShortcutHint}"
                                                   FontSize="10"
                                                   FontFamily="Consolas, Segoe UI"
                                                   Foreground="{StaticResource ThemeAccentOrangeBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State Message -->
                <StackPanel x:Name="EmptyStatePanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="20">
                    <TextBlock Text="🔍"
                               FontSize="26"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               Opacity="0.7"/>
                    <TextBlock Text="No matching commands found"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ThemeTextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Try searching for tasks, focus, notes, or companions."
                               FontSize="12"
                               Foreground="{StaticResource ThemeTextDimBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 3. Bottom Footer Bar -->
            <Border Grid.Row="3"
                    Background="{StaticResource ThemeSurfaceBrush}"
                    BorderBrush="{StaticResource ThemeBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9"
                    Padding="14,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="↑↓ Navigate"
                                   FontSize="11"
                                   Foreground="{StaticResource ThemeTextMutedBrush}"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="↵ Execute"
                                   FontSize="11"
                                   Foreground="{StaticResource ThemeTextMutedBrush}"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="ESC Close"
                                   FontSize="11"
                                   Foreground="{StaticResource ThemeTextMutedBrush}"/>
                    </StackPanel>

                    <TextBlock x:Name="CommandCountText"
                               Grid.Column="1"
                               Text="0 commands"
                               FontSize="11"
                               Foreground="{StaticResource ThemeTextMutedBrush}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
