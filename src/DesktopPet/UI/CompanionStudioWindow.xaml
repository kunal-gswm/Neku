<Window x:Class="DesktopPet.UI.CompanionStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion Studio - Neku"
        Width="860" Height="640"
        MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1A29"
        Foreground="#FFF3E8FF"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Dark Theme Control Styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF3E8FF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FFA78BFA"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="SectionHead">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFF3E8FF"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#FF8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF9F75FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF483C66"/>
                    <Setter Property="Foreground" Value="#FFA78BFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#FF282337"/>
            <Setter Property="Foreground" Value="#FFF3E8FF"/>
            <Setter Property="BorderBrush" Value="#FF483C66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF352E49"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF201B2C"/>
                    <Setter Property="Foreground" Value="#FF6D6487"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF3E8FF"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF282337"/>
            <Setter Property="Foreground" Value="#FFF3E8FF"/>
            <Setter Property="BorderBrush" Value="#FF483C66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFA78BFA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}" Margin="0,0,8,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#FF8B5CF6"/>
                                <Setter Property="Foreground" Value="#FFF3E8FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFF3E8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ─────────────── Top Header ─────────────── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Background="#FF282337" CornerRadius="6" BorderBrush="#FF483C66" BorderThickness="1" Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Active Desktop Pet: " FontSize="11" Foreground="#FFA78BFA"/>
                    <TextBlock x:Name="ActivePetIndicatorText" Text="Neku" FontSize="11" FontWeight="Bold" Foreground="#FF34D399"/>
                </StackPanel>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🎨 Companion Studio" FontSize="18" FontWeight="Bold" Foreground="#FFF3E8FF"/>
                <TextBlock Text="Manage desktop companions, preview real animation frames, and tune personality." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ─────────────── Main Content Grid ─────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="260" MaxWidth="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Column: Character Library ── -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Companion Library" Style="{StaticResource SectionHead}"/>

                <!-- Selected Pack Info Card (Docked Bottom) -->
                <Border DockPanel.Dock="Bottom" Background="#FF282337" CornerRadius="8" BorderBrush="#FF483C66" BorderThickness="1" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="SelectedPackTitleText" Text="Companion Name" FontWeight="Bold" FontSize="13" Foreground="#FFF3E8FF"/>
                        <TextBlock x:Name="SelectedPackDescriptionText" Text="Pack description..." Style="{StaticResource Hint}" Margin="0,4,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Name="SelectedPackDimensionsText" Text="64x64 px" FontSize="10" Foreground="#FFA78BFA"/>
                            <TextBlock Text=" • " FontSize="10" Foreground="#FFA78BFA"/>
                            <TextBlock x:Name="SelectedPackScaleText" Text="Scale: 1.0x" FontSize="10" Foreground="#FFA78BFA"/>
                            <TextBlock Text=" • " FontSize="10" Foreground="#FFA78BFA"/>
                            <TextBlock x:Name="SelectedPackStatusText" Text="Built-in" FontSize="10" Foreground="#FFA78BFA"/>
                        </StackPanel>

                        <TextBlock x:Name="PackErrorText" Foreground="#FFEF4444" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed"/>

                        <Button x:Name="SetActivePetButton" Content="Set as Desktop Companion" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch" Click="SetActivePetButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Library List -->
                <ListBox x:Name="PacksListBox" Background="#FF16131F" BorderBrush="#FF483C66" BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="PacksListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6"/>
                            <Setter Property="Margin" Value="2"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF231E30"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF483C66"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF2E2741"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF8B5CF6"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Background="#FF282337" BorderBrush="#FF483C66" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Image Source="{Binding Preview}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>

                                <!-- Text info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <DockPanel LastChildFill="True">
                                        <!-- Active Badge -->
                                        <Border DockPanel.Dock="Right" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                Background="#FF059669" CornerRadius="4" Padding="4,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <!-- Name -->
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Foreground="#FFF3E8FF"/>
                                    </DockPanel>

                                    <!-- Details & Origin Badge -->
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Background="#FF37304A" CornerRadius="3" Padding="3,1" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding BadgeText}" FontSize="8" FontWeight="SemiBold" Foreground="#FFA78BFA"/>
                                        </Border>
                                        <TextBlock Text="{Binding DetailsLine}" FontSize="10" Foreground="#FFA78BFA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- ── Right Column: Studio Preview & Customization ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Dedicated Animation Preview Stage -->
                <Border Grid.Row="0" Background="#FF16131F" CornerRadius="8" BorderBrush="#FF483C66" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Preview Stage Display -->
                        <Border Grid.Column="0" Height="150" CornerRadius="8" Background="#FF231E30" BorderBrush="#FF483C66" BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <!-- Subtle checkerboard or grid pattern placeholder -->
                                <Image x:Name="StudioPreviewImage" Width="112" Height="112"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Border>

                        <!-- Preview Controls & Animation List -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <!-- Header & Current Animation Status -->
                            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Speed: " FontSize="11" Foreground="#FFA78BFA" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="PreviewSpeedComboBox" Width="72" SelectionChanged="PreviewSpeedComboBox_SelectionChanged">
                                        <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                        <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True"/>
                                        <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                        <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PlayingAnimationNameText" Text="Animation: idle" FontWeight="Bold" FontSize="13" Foreground="#FFF3E8FF"/>
                                    <TextBlock x:Name="PlayingAnimationInfoText" Text="Looping • Native speed" FontSize="10" Foreground="#FFA78BFA"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Playback Control Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="PlayPauseButton" Content="⏸ Pause" Width="80" Margin="0,0,8,0" Click="PlayPauseButton_Click"/>
                                <Button x:Name="ResetIdleButton" Content="↺ Reset to Idle" Width="105" Click="ResetIdleButton_Click"/>
                            </StackPanel>

                            <!-- Manifest Animation Chips / Selector -->
                            <TextBlock Text="Genuine Animations in Manifest (click to preview):" FontSize="11" FontWeight="SemiBold" Foreground="#FFA78BFA" Margin="0,0,0,4"/>
                            <ScrollViewer Height="66" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <WrapPanel x:Name="AnimationButtonsWrapPanel" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Tabs: Personality, Behavior & Appearance -->
                <TabControl Grid.Row="2">
                    <!-- Tab 1: Personality & Reactions -->
                    <TabItem Header="Personality &amp; Reactions">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,12,6,6">
                                <!-- Personality Preset -->
                                <TextBlock Text="Personality Preset" Style="{StaticResource SectionHead}"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="PersonalityPresetComboBox" Grid.Column="0" SelectionChanged="PersonalityPresetComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Calm" Tag="Calm"/>
                                        <ComboBoxItem Content="Playful" Tag="Playful"/>
                                        <ComboBoxItem Content="Expressive" Tag="Expressive"/>
                                        <ComboBoxItem Content="Chaotic" Tag="Chaotic"/>
                                        <ComboBoxItem Content="Custom" Tag="Custom"/>
                                    </ComboBox>

                                    <TextBlock x:Name="PresetDescriptionText" Grid.Column="2" VerticalAlignment="Center"
                                               Text="Balanced companion with rich reactions and occasional chatter."
                                               Style="{StaticResource Hint}"/>
                                </Grid>

                                <Separator Background="#FF352E49" Margin="0,4,0,10"/>

                                <!-- Reaction Triggers -->
                                <TextBlock Text="Companion Reaction Triggers" Style="{StaticResource SectionHead}"/>
                                <CheckBox x:Name="EnableFocusReactionsCheckBox" Content="Focus session celebration (celebrates completion with joyful animation)"/>
                                <CheckBox x:Name="EnableBreakReactionsCheckBox" Content="Break &amp; stretch reminders (prompts gentle stretching during breaks)"/>
                                <CheckBox x:Name="EnablePettingReactionsCheckBox" Content="Petting &amp; cursor reactions (hearts and purring responses when cursor hovers)"/>
                                <CheckBox x:Name="EnableDevReactionsCheckBox" Content="Developer build &amp; test reactions (opt-in; celebrates passing builds on port 48123)"/>

                                <TextBlock Text="Note: Quiet Mode and Reduced Motion take priority over active personality reactions."
                                           Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Appearance & Controls -->
                    <TabItem Header="Appearance &amp; Scale">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,12,6,6">
                                <!-- Size Scale -->
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Desktop Companion Size Scale" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SizeValueText" Grid.Column="1" Text="1.00x" FontWeight="Bold" Foreground="#FF8B5CF6"/>
                                </Grid>
                                <Slider x:Name="SizeSlider" Minimum="0.5" Maximum="2.0" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="Ranges from 0.5x (compact) to 2.0x (large). Default is 1.0x." Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                                <!-- Animation Speed -->
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Animation &amp; Walk Speed" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SpeedValueText" Grid.Column="1" Text="1.0x" FontWeight="Bold" Foreground="#FF8B5CF6"/>
                                </Grid>
                                <Slider x:Name="SpeedSlider" Minimum="0.3" Maximum="2.5" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="Controls animation frame rate and movement velocity on screen." Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                                <!-- Opacity -->
                                <Grid Margin="0,4,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Window Opacity" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OpacityValueText" Grid.Column="1" Text="100%" FontWeight="Bold" Foreground="#FF8B5CF6"/>
                                </Grid>
                                <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="Translucency lets you see through behind the pet window." Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                                <Separator Background="#FF352E49" Margin="0,4,0,10"/>

                                <!-- Accessibility & Safety Overrides -->
                                <TextBlock Text="Accessibility Overrides" Style="{StaticResource SectionHead}"/>
                                <CheckBox x:Name="ReducedMotionCheckBox" Content="Reduced Motion (calms animations and wandering)"/>
                                <CheckBox x:Name="QuietModeCheckBox" Content="Quiet Mode (suppresses notifications and speech bubble prompts)"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- ─────────────── Bottom Footer ─────────────── -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button x:Name="RestoreDefaultsButton" DockPanel.Dock="Left" Content="↺ Restore Defaults"
                    Style="{StaticResource SecondaryButton}" Click="RestoreDefaultsButton_Click"/>

            <Button x:Name="DoneButton" DockPanel.Dock="Right" Content="Done" Width="80"
                    Style="{StaticResource PrimaryButton}" Click="DoneButton_Click"/>

            <TextBlock x:Name="FooterStatusText" Text="Changes apply live to your active companion."
                       Foreground="#FFA78BFA" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
