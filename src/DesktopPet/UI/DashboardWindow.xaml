<Window x:Class="DesktopPet.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neku Productivity Hub"
        Width="960" Height="640"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FF161320"
        Foreground="#FFF3E8FF"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProductivityTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource ThemeBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT NAVIGATION RAIL                       -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="{StaticResource RailBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Hub Header -->
                <StackPanel DockPanel.Dock="Top" Margin="14,16,14,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🐾" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Neku Hub" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Productivity &amp; Focus" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="28,2,0,0"/>
                </StackPanel>

                <!-- Mini Active Focus Bar at Bottom -->
                <Border DockPanel.Dock="Bottom" Background="#FF161320" Margin="8,8,8,10" Padding="10" CornerRadius="8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" x:Name="RailTimerBadge" Text="IDLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock DockPanel.Dock="Right" x:Name="RailTimerDigits" Text="25:00" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}"/>
                        </DockPanel>
                        <TextBlock x:Name="RailActiveTaskText" Text="No active task" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="RailPlayPauseBtn" AutomationProperties.Name="Play or Pause Focus Session" Content="▶ Play" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="11" Margin="0,0,4,0" Click="RailPlayPauseBtn_Click"/>
                            <Button x:Name="RailStopBtn" AutomationProperties.Name="Stop Focus Session" Content="⏹ Stop" Style="{StaticResource DangerButton}" Padding="8,3" FontSize="11" Click="RailStopBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nav Buttons -->
                <StackPanel Margin="6,0,6,0">
                    <Button x:Name="NavOverviewBtn" AutomationProperties.Name="Overview Navigation" Content="📊  Overview" Style="{StaticResource NavRailButton}" Tag="Overview" Click="NavBtn_Click"/>
                    <Button x:Name="NavTasksBtn" AutomationProperties.Name="Tasks Navigation" Content="📋  Tasks" Style="{StaticResource NavRailButton}" Tag="Tasks" Click="NavBtn_Click"/>
                    <Button x:Name="NavFocusBtn" AutomationProperties.Name="Focus Timer Navigation" Content="⏱️  Focus Timer" Style="{StaticResource NavRailButton}" Tag="Focus" Click="NavBtn_Click"/>
                    <Button x:Name="NavHistoryBtn" AutomationProperties.Name="Focus History Navigation" Content="📜  Focus History" Style="{StaticResource NavRailButton}" Tag="History" Click="NavBtn_Click"/>
                    <Button x:Name="NavInsightsBtn" AutomationProperties.Name="Insights Navigation" Content="📈  Insights" Style="{StaticResource NavRailButton}" Tag="Insights" Click="NavBtn_Click"/>
                    <Button x:Name="NavGoalsBtn" AutomationProperties.Name="Goals Navigation" Content="🎯  Goals" Style="{StaticResource NavRailButton}" Tag="Goals" Click="NavBtn_Click"/>
                    <Button x:Name="NavAgentBtn" AutomationProperties.Name="Agent Activity Navigation" Content="🤖  Agent Activity" Style="{StaticResource NavRailButton}" Tag="Agent" Click="NavBtn_Click"/>
                    <Button x:Name="NavRadarBtn" AutomationProperties.Name="Developer Radar Navigation" Content="📡  Developer Radar" Style="{StaticResource NavRailButton}" Tag="Radar" Click="NavBtn_Click"/>
                    <Button x:Name="NavHealthBtn" AutomationProperties.Name="System Health Navigation" Content="💻  System Health" Style="{StaticResource NavRailButton}" Tag="Health" Click="NavBtn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN CONTENT AREA (6 VIEWS)                -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Margin="16,14,16,14">

            <!-- 1. OVERVIEW VIEW -->
            <Grid x:Name="OverviewView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Title -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Productivity Overview" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="OverviewDateText" Text="Today" FontSize="13" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Metric Cards Grid -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}" Cursor="Hand" MouseDown="CardFocus_MouseDown">
                        <StackPanel>
                            <TextBlock Text="⏱️ Focus Today" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="MetricFocusTodayText" Text="0m" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,4,0,2"/>
                            <TextBlock x:Name="MetricFocusGoalSubText" Text="Goal: 100m (0%)" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource MetricCardBorder}" Cursor="Hand" MouseDown="CardTasks_MouseDown">
                        <StackPanel>
                            <TextBlock Text="✅ Tasks Done Today" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="MetricTasksDoneText" Text="0" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,4,0,2"/>
                            <TextBlock x:Name="MetricTasksGoalSubText" Text="Goal: 3 tasks" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MetricCardBorder}" Cursor="Hand" MouseDown="CardTasks_MouseDown">
                        <StackPanel>
                            <TextBlock Text="📋 Tasks Remaining" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="MetricTasksPendingText" Text="0" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,2"/>
                            <TextBlock x:Name="MetricOverdueSubText" Text="0 overdue" FontSize="10" Foreground="#FFFCA5A5" Cursor="Hand" MouseDown="OverdueText_MouseDown"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource MetricCardBorder}" Cursor="Hand" MouseDown="CardGoals_MouseDown">
                        <StackPanel>
                            <TextBlock Text="🔥 Focus Streak" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="MetricStreakText" Text="0 days" FontSize="22" FontWeight="Bold" Foreground="#FFFBBF24" Margin="0,4,0,2"/>
                            <TextBlock x:Name="MetricStreakSubText" Text="Best: 0 days" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Active Focus Banner & Quick Add -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Quick Task Input -->
                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OverviewQuickTaskBox" Grid.Column="0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                     Text="Add a new task for today..." GotFocus="OverviewQuickTaskBox_GotFocus" LostFocus="OverviewQuickTaskBox_LostFocus" KeyDown="OverviewQuickTaskBox_KeyDown"/>
                            <Button x:Name="OverviewQuickAddBtn" Grid.Column="1" Content="+ Add Task" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="6,0,0,0" Click="OverviewQuickAddBtn_Click"/>
                        </Grid>
                    </Border>

                    <!-- Focus CTA Button -->
                    <Button x:Name="OverviewQuickFocusBtn" Grid.Column="1" Content="🎯 Start 25m Focus" Style="{StaticResource OrangeButton}" Padding="16,8" Click="OverviewQuickFocusBtn_Click"/>
                </Grid>

                <!-- Split lower area: Mini Weekly Chart & Recent Focus Sessions -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mini Weekly Activity Chart -->
                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Weekly Focus Trend" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            <Canvas x:Name="OverviewWeeklyCanvas" ClipToBounds="True" Height="140" SizeChanged="OverviewWeeklyCanvas_SizeChanged"/>
                        </DockPanel>
                    </Border>

                    <!-- Recent Sessions List -->
                    <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Recent Focus Activity" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                <Button Content="View All →" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" HorizontalAlignment="Right" Click="ViewAllHistory_Click"/>
                            </DockPanel>
                            <ListBox x:Name="OverviewRecentListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FF352C4A" BorderThickness="0,0,0,1" Padding="4,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TypeDisplay}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TaskTitle, TargetNullValue='Free Focus'}" FontSize="12" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FormattedDate}" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DurationDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 2. TASKS VIEW -->
            <Grid x:Name="TasksView" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="280" MaxWidth="500"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Filters & List -->
                <DockPanel Grid.Column="0">
                    <!-- Tabs Bar -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="TaskTabToday" Content="☀️ Today" Style="{StaticResource FilterChipButton}" Margin="0,0,4,4" Tag="Today" Click="TaskTab_Click"/>
                        <Button x:Name="TaskTabUpcoming" Content="📅 Upcoming" Style="{StaticResource FilterChipButton}" Margin="0,0,4,4" Tag="Upcoming" Click="TaskTab_Click"/>
                        <Button x:Name="TaskTabInbox" Content="📥 Inbox" Style="{StaticResource FilterChipButton}" Margin="0,0,4,4" Tag="Inbox" Click="TaskTab_Click"/>
                        <Button x:Name="TaskTabInProgress" Content="⚡ In Progress" Style="{StaticResource FilterChipButton}" Margin="0,0,4,4" Tag="InProgress" Click="TaskTab_Click"/>
                        <Button x:Name="TaskTabOverdue" Content="⚠️ Overdue" Style="{StaticResource FilterChipButton}" Margin="0,0,4,4" Tag="Overdue" Click="TaskTab_Click"/>
                        <Button x:Name="TaskTabAll" Content="📋 All" Style="{StaticResource FilterChipButton}" Margin="0,0,4,4" Tag="All" Click="TaskTab_Click"/>
                        <Button x:Name="TaskTabDone" Content="✅ Done" Style="{StaticResource FilterChipButton}" Margin="0,0,4,4" Tag="Completed" Click="TaskTab_Click"/>
                    </WrapPanel>

                    <!-- Search & Filter Controls -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TaskSearchBox" Grid.Column="0" Height="28" TextChanged="TaskSearchBox_TextChanged" Margin="0,0,4,0" ToolTip="Search tasks (Ctrl+F)"/>
                        <ComboBox x:Name="TaskProjectCombo" Grid.Column="1" Height="28" Width="85" Margin="0,0,4,0" SelectionChanged="TaskFilter_Changed"/>
                        <ComboBox x:Name="TaskTagCombo" Grid.Column="2" Height="28" Width="80" Margin="0,0,4,0" SelectionChanged="TaskFilter_Changed"/>
                        <ComboBox x:Name="TaskSortCombo" Grid.Column="3" Height="28" Width="85" SelectionChanged="TaskFilter_Changed">
                            <ComboBoxItem Content="Due Date" IsSelected="True"/>
                            <ComboBoxItem Content="Priority"/>
                            <ComboBoxItem Content="Newest"/>
                            <ComboBoxItem Content="Title"/>
                        </ComboBox>
                    </Grid>

                    <!-- New Task & Export Buttons -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="TaskAddNewBtn" Height="28" Content="+ New Task" Margin="0,0,4,0" Click="TaskAddNewBtn_Click"/>
                        <Button Grid.Column="1" Content="📥 CSV" Height="28" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,4,0" Click="TasksExportCsv_Click" ToolTip="Export tasks to CSV"/>
                        <Button Grid.Column="2" Content="📥 JSON" Height="28" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Click="TasksExportJson_Click" ToolTip="Export tasks to JSON"/>
                    </Grid>

                    <!-- Empty State -->
                    <Border x:Name="TaskEmptyBorder" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📝" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TaskEmptyTitle" Text="No tasks found" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock x:Name="TaskEmptySub" Text="Click + New Task to create one" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Tasks ListBox -->
                    <ListBox x:Name="TasksListBox" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="TasksListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6,6" BorderBrush="#FF352C4A" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" Click="TaskItemCheck_Click"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Project}" FontSize="9" Background="#FF3B314F" Foreground="{StaticResource TextMutedBrush}" Padding="4,1" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding PriorityDisplay}" FontSize="9" Foreground="#FFFBBF24" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding FormattedDueDate}" FontSize="9" Foreground="{StaticResource TextDimBrush}" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding SubtasksSummary}" FontSize="9" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,4,0"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding PomodoroDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Grid Splitter -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                <!-- Right Column: Task Detail Editor -->
                <Border Grid.Column="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <!-- No Selection Placeholder -->
                        <TextBlock x:Name="TaskNoSelectionText" Text="Select a task to view and edit details" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

                        <!-- Detail Form -->
                        <ScrollViewer x:Name="TaskDetailScrollViewer" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Action Bar Card -->
                                <Border Background="#FF1E1A29" BorderBrush="#FF352C4A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <DockPanel LastChildFill="False">
                                        <CheckBox DockPanel.Dock="Left" x:Name="DetailCompleteCheck" Content="Mark Completed" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Click="DetailCompleteCheck_Click"/>
                                        <Button DockPanel.Dock="Right" x:Name="DetailStartFocusBtn" Content="🎯 Start Focus" Style="{StaticResource OrangeButton}" Padding="14,6" Click="DetailStartFocusBtn_Click"/>
                                    </DockPanel>
                                </Border>

                                <!-- Section: General Information -->
                                <Border Background="#FF1E1A29" BorderBrush="#FF352C4A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Title" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DetailTitleBox" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" TextChanged="DetailField_Changed"/>

                                        <TextBlock Text="Description" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="DetailDescBox" Height="58" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="DetailField_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Organization & Scheduling -->
                                <Border Background="#FF1E1A29" BorderBrush="#FF352C4A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="DetailStatusCombo" Height="28" SelectionChanged="DetailStatus_SelectionChanged">
                                                    <ComboBoxItem Content="Inbox"/>
                                                    <ComboBoxItem Content="Todo"/>
                                                    <ComboBoxItem Content="In Progress"/>
                                                    <ComboBoxItem Content="Completed"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Priority" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="DetailPriorityCombo" Height="28" SelectionChanged="DetailPriority_SelectionChanged">
                                                    <ComboBoxItem Content="Low"/>
                                                    <ComboBoxItem Content="Normal"/>
                                                    <ComboBoxItem Content="High"/>
                                                    <ComboBoxItem Content="Urgent 🔥"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Project / Category" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="DetailProjectBox" Height="28" TextChanged="DetailField_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Tags (comma-separated)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="DetailTagsBox" Height="28" TextChanged="DetailField_Changed"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                <TextBlock Text="Due Date" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <DatePicker x:Name="DetailDueDatePicker" Height="28" SelectedDateChanged="DetailDueDate_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                                <TextBlock Text="Recurrence" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="DetailRecurrenceCombo" Height="28" SelectionChanged="DetailRecurrence_Changed">
                                                    <ComboBoxItem Content="None"/>
                                                    <ComboBoxItem Content="Daily"/>
                                                    <ComboBoxItem Content="Weekly"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="3,0,0,0">
                                                <TextBlock Text="Est. Time" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="DetailEstMinutesCombo" Height="28" SelectionChanged="DetailEstMinutes_Changed">
                                                    <ComboBoxItem Content="None"/>
                                                    <ComboBoxItem Content="25m"/>
                                                    <ComboBoxItem Content="50m"/>
                                                    <ComboBoxItem Content="75m"/>
                                                    <ComboBoxItem Content="100m"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Subtasks / Checklist -->
                                <Border Background="#FF1E1A29" BorderBrush="#FF352C4A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Subtasks / Checklist" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="DetailNewSubtaskBox" Height="28" KeyDown="DetailNewSubtaskBox_KeyDown"/>
                                            <Button x:Name="DetailAddSubtaskBtn" Grid.Column="1" Content="+ Add" Style="{StaticResource SecondaryButton}" Height="28" Margin="4,0,0,0" Padding="8,4" Click="DetailAddSubtaskBtn_Click"/>
                                        </Grid>
                                        <ItemsControl x:Name="DetailSubtasksItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,4" Margin="0,2" Background="#FF221C30" CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" VerticalAlignment="Center" Margin="0,0,8,0" Click="SubtaskCheck_Click"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Foreground="White" FontSize="12"/>
                                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButton}" Padding="5,1" FontSize="10" Click="SubtaskDelete_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Focus Stats on Task -->
                                <Border Background="#FF1E1A29" BorderBrush="#FF352C4A" BorderThickness="1" Padding="10,8" CornerRadius="6" Margin="0,0,0,12">
                                    <TextBlock x:Name="DetailFocusStatsText" Text="🍅 0 sessions (0 mins focus)" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentOrangeBrush}"/>
                                </Border>

                                <!-- Bottom Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="DetailClearCompletedBtn" Content="Clear Completed" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DetailClearCompletedBtn_Click"/>
                                    <Button x:Name="DetailDeleteBtn" Content="🗑️ Delete Task" Style="{StaticResource DangerButton}" Click="DetailDeleteBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. FOCUS VIEW -->
            <Grid x:Name="FocusView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Pomodoro Focus Workspace" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                <!-- Main Timer Display Panel -->
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="480">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Session Mode Badge -->
                        <Border x:Name="FocusModeBadge" Background="#FF3B2D54" CornerRadius="12" Padding="14,4" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock x:Name="FocusModeText" Text="READY TO FOCUS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentOrangeBrush}"/>
                        </Border>

                        <!-- Large Time Text -->
                        <TextBlock x:Name="FocusBigTimerDigits" Text="25:00" FontSize="64" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <!-- Associated Task -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="Target Task: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <ComboBox x:Name="FocusTaskSelectorCombo" Width="200" SelectionChanged="FocusTaskSelectorCombo_SelectionChanged"/>
                        </StackPanel>

                        <!-- Big Play / Pause / Stop Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Button x:Name="FocusMainActionBtn" Content="▶ Start Focus" Style="{StaticResource OrangeButton}" FontSize="15" Padding="24,10" Margin="0,0,10,0" Click="FocusMainActionBtn_Click"/>
                            <Button x:Name="FocusResetBtn" Content="🔄 Reset" Style="{StaticResource SecondaryButton}" FontSize="13" Padding="14,10" Margin="0,0,10,0" Click="FocusResetBtn_Click"/>
                            <Button x:Name="FocusCancelBtn" Content="⏹ Cancel" Style="{StaticResource DangerButton}" FontSize="13" Padding="14,10" Click="FocusCancelBtn_Click"/>
                        </StackPanel>

                        <!-- Skip Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Button Content="☕ Take Short Break" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="FocusShortBreakBtn_Click"/>
                            <Button Content="🌴 Take Long Break" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Click="FocusLongBreakBtn_Click"/>
                        </StackPanel>

                        <!-- Cycle Indicator -->
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="FocusCycleDotsText" Text="Pomodoro 1 of 4 in cycle" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bottom Config row: Dual Grouped Cards -->
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Session Durations & Flow -->
                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="⚙️ Session Durations &amp; Flow" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <WrapPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,4" VerticalAlignment="Center">
                                    <TextBlock Text="Focus: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FocusDurBox" Width="38" Height="26" Text="25" LostFocus="FocusDurBox_LostFocus" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="m" FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,4" VerticalAlignment="Center">
                                    <TextBlock Text="Short Break: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FocusShortBreakBox" Width="38" Height="26" Text="5" LostFocus="FocusShortBreakBox_LostFocus" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="m" FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,4" VerticalAlignment="Center">
                                    <TextBlock Text="Long Break: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="FocusLongBreakBox" Width="38" Height="26" Text="15" LostFocus="FocusLongBreakBox_LostFocus" HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="m" FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="FocusAutoBreakCheck" Content="Auto-breaks" Margin="0,0,10,4" VerticalAlignment="Center" Click="FocusAutoBreakCheck_Click" ToolTip="Automatically transition into break when focus session ends"/>
                                <CheckBox x:Name="FocusAutoFocusCheck" Content="Auto-focus" Margin="0,0,4,4" VerticalAlignment="Center" Click="FocusAutoFocusCheck_Click" ToolTip="Automatically start next focus session when break ends"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Productivity Alerts -->
                    <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🔔 Productivity Alerts" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <WrapPanel VerticalAlignment="Center">
                                <CheckBox x:Name="FocusNotifyFocusCheck" Content="Focus alert" Margin="0,0,12,4" VerticalAlignment="Center" Click="FocusReminderToggle_Click" ToolTip="Alert when focus session completes"/>
                                <CheckBox x:Name="FocusNotifyBreakCheck" Content="Break alert" Margin="0,0,12,4" VerticalAlignment="Center" Click="FocusReminderToggle_Click" ToolTip="Alert when break session completes"/>
                                <CheckBox x:Name="FocusNotifyUpcomingCheck" Content="Due today" Margin="0,0,12,4" VerticalAlignment="Center" Click="FocusReminderToggle_Click" ToolTip="Remind for tasks due today"/>
                                <CheckBox x:Name="FocusNotifyOverdueCheck" Content="Overdue" Margin="0,0,4,4" VerticalAlignment="Center" Click="FocusReminderToggle_Click" ToolTip="Remind for overdue tasks"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 4. HISTORY VIEW -->
            <Grid x:Name="HistoryView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header & Controls -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Focus Session History" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="💾 Backup All" Height="28" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="ProductivityBackup_Click" ToolTip="Export complete productivity backup (JSON)"/>
                        <Button Content="📥 Export CSV" Height="28" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="HistoryExportCsv_Click"/>
                        <Button Content="📥 Export JSON" Height="28" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="HistoryExportJson_Click"/>
                        <Button Content="🗑️ Clear All" Height="28" Style="{StaticResource DangerButton}" Click="HistoryClearAll_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Filter Bar -->
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Range: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="HistoryRangeCombo" Height="28" Width="110" SelectionChanged="HistoryRangeCombo_SelectionChanged">
                                <ComboBoxItem Content="Today" IsSelected="True"/>
                                <ComboBoxItem Content="Yesterday"/>
                                <ComboBoxItem Content="Last 7 Days"/>
                                <ComboBoxItem Content="Last 30 Days"/>
                                <ComboBoxItem Content="All Time"/>
                                <ComboBoxItem Content="Custom Range…"/>
                            </ComboBox>
                            <StackPanel x:Name="HistoryCustomDatePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="6,0,0,0">
                                <TextBlock Text="From:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <DatePicker x:Name="HistoryStartDatePicker" Height="28" Width="95" SelectedDateChanged="HistoryCustomDate_Changed"/>
                                <TextBlock Text="To:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,3,0"/>
                                <DatePicker x:Name="HistoryEndDatePicker" Height="28" Width="95" SelectedDateChanged="HistoryCustomDate_Changed"/>
                                <Button x:Name="HistoryResetRangeBtn" Content="↺" Style="{StaticResource SecondaryButton}" Height="28" Padding="6,1" FontSize="11" Margin="3,0,0,0" ToolTip="Reset to Today" Click="HistoryResetRangeBtn_Click"/>
                            </StackPanel>
                            <TextBlock Text="Type: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox x:Name="HistoryTypeCombo" Height="28" Width="95" SelectionChanged="HistoryTypeCombo_SelectionChanged">
                                <ComboBoxItem Content="All Types" IsSelected="True"/>
                                <ComboBoxItem Content="Focus"/>
                                <ComboBoxItem Content="Short Break"/>
                                <ComboBoxItem Content="Long Break"/>
                            </ComboBox>
                            <TextBlock Text="Status: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox x:Name="HistoryStatusCombo" Height="28" Width="95" SelectionChanged="HistoryStatusCombo_SelectionChanged">
                                <ComboBoxItem Content="All Status" IsSelected="True"/>
                                <ComboBoxItem Content="Completed"/>
                                <ComboBoxItem Content="Interrupted"/>
                                <ComboBoxItem Content="Cancelled"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="HistorySummaryStatsText" Text="Total: 0m focus across 0 sessions" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentOrangeBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- History Table -->
                <DataGrid x:Name="HistoryDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                          Foreground="White" RowBackground="#FF221C30" AlternatingRowBackground="#FF282238"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF3B314F" HeadersVisibility="Column"
                          SelectionChanged="HistoryDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding FormattedDate}" Width="100"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding FormattedTime}" Width="110"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="100"/>
                        <DataGridTextColumn Header="Task" Binding="{Binding TaskTitle}" Width="*"/>
                        <DataGridTextColumn Header="Project" Binding="{Binding Project}" Width="90"/>
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="80"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="95"/>
                        <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Session Notes Editor -->
                <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Session Notes: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="HistoryNotesTextBox" Grid.Column="1" Height="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="HistorySaveNotesBtn" Grid.Column="2" Content="Save Note" Style="{StaticResource SecondaryButton}" Height="28" Padding="10,3" FontSize="11" Click="HistorySaveNotesBtn_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. INSIGHTS VIEW -->
            <Grid x:Name="InsightsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Productivity Insights &amp; Analytics" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel x:Name="InsightsCustomDatePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,8,0">
                            <TextBlock Text="From:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <DatePicker x:Name="InsightsStartDatePicker" Height="28" Width="95" SelectedDateChanged="InsightsCustomDate_Changed"/>
                            <TextBlock Text="To:" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,3,0"/>
                            <DatePicker x:Name="InsightsEndDatePicker" Height="28" Width="95" SelectedDateChanged="InsightsCustomDate_Changed"/>
                            <Button x:Name="InsightsResetRangeBtn" Content="↺" Style="{StaticResource SecondaryButton}" Height="28" Padding="6,1" FontSize="11" Margin="3,0,0,0" ToolTip="Reset to Last 7 Days" Click="InsightsResetRangeBtn_Click"/>
                        </StackPanel>
                        <ComboBox x:Name="InsightsRangeCombo" Height="28" Width="130" VerticalAlignment="Center" SelectionChanged="InsightsRangeCombo_SelectionChanged">
                            <ComboBoxItem Content="Last 7 Days" IsSelected="True"/>
                            <ComboBoxItem Content="Today"/>
                            <ComboBoxItem Content="Last 30 Days"/>
                            <ComboBoxItem Content="This Month"/>
                            <ComboBoxItem Content="All Time"/>
                            <ComboBoxItem Content="Custom Range…"/>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>

                <!-- KPI Metric Row -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Focus Time" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="InsightsFocusHoursText" Text="0h" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Sessions" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="InsightsSessionsText" Text="0" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Completion Rate" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="InsightsRateText" Text="0%" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource MetricCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Tasks Done" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="InsightsTasksText" Text="0" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MetricCardBorder}">
                        <StackPanel>
                            <TextBlock Text="Planned vs Actual" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="InsightsPlannedVsActualText" Text="0m / 0m" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Charts & Heatmap Area -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Daily Focus Bar Chart -->
                            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,6,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Daily Focus Minutes" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <Canvas x:Name="InsightsBarChartCanvas" ClipToBounds="True" Height="190" SizeChanged="InsightsBarChartCanvas_SizeChanged"/>
                                </DockPanel>
                            </Border>

                            <!-- Projects Breakdown -->
                            <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="6,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Project Focus Breakdown" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                                    <ListBox x:Name="InsightsProjectsListBox" Height="190" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="4,6" BorderBrush="#FF352C4A" BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <Grid>
                                                            <TextBlock Text="{Binding ProjectName}" FontWeight="Medium" Foreground="White" FontSize="12"/>
                                                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource AccentOrangeBrush}">
                                                                <Run Text="{Binding FocusMinutes}"/>
                                                                <Run Text="m ("/>
                                                                <Run Text="{Binding Percentage}"/>
                                                                <Run Text="%)"/>
                                                            </TextBlock>
                                                        </Grid>
                                                        <!-- Mini visual progress bar -->
                                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="4" Margin="0,4,0,0" Foreground="{StaticResource AccentPurpleBrush}" Background="#FF3B314F" BorderThickness="0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Activity Heatmap Card -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Activity Heatmap (Past 12 Weeks)" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Less " FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <Rectangle Width="10" Height="10" Fill="#282238" Margin="2,0"/>
                                        <Rectangle Width="10" Height="10" Fill="#4C2D6D" Margin="2,0"/>
                                        <Rectangle Width="10" Height="10" Fill="#7C3AED" Margin="2,0"/>
                                        <Rectangle Width="10" Height="10" Fill="#F97316" Margin="2,0"/>
                                        <Rectangle Width="10" Height="10" Fill="#22C55E" Margin="2,0"/>
                                        <TextBlock Text=" More" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>
                                <Canvas x:Name="InsightsHeatmapCanvas" ClipToBounds="True" Height="110" SizeChanged="InsightsHeatmapCanvas_SizeChanged"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 6. GOALS VIEW -->
            <Grid x:Name="GoalsView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Goals &amp; Habit Streaks" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Focus Goals Section -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Daily Focus Goal -->
                            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="☀️ Daily Focus Goal" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="GoalsDailyFocusProgressText" Text="0 / 100 mins (0%)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,8,0,6"/>
                                    <ProgressBar x:Name="GoalsDailyFocusBar" Height="10" Value="0" Maximum="100" Foreground="{StaticResource AccentOrangeBrush}" Background="#FF3B314F" BorderThickness="0" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Target: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="GoalsDailyFocusTargetBox" Height="26" Width="60" Text="100" HorizontalContentAlignment="Center" LostFocus="GoalsTarget_LostFocus"/>
                                        <TextBlock Text=" mins/day" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Weekly Focus Goal -->
                            <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="📅 Weekly Focus Goal" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="GoalsWeeklyFocusProgressText" Text="0 / 500 mins (0%)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" Margin="0,8,0,6"/>
                                    <ProgressBar x:Name="GoalsWeeklyFocusBar" Height="10" Value="0" Maximum="100" Foreground="{StaticResource AccentPurpleBrush}" Background="#FF3B314F" BorderThickness="0" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Target: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="GoalsWeeklyFocusTargetBox" Height="26" Width="60" Text="500" HorizontalContentAlignment="Center" LostFocus="GoalsTarget_LostFocus"/>
                                        <TextBlock Text=" mins/week" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Task Goals Section -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Daily Task Goal -->
                            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="☀️ Daily Task Goal" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="GoalsDailyTaskProgressText" Text="0 / 3 tasks (0%)" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,8,0,6"/>
                                    <ProgressBar x:Name="GoalsDailyTaskBar" Height="10" Value="0" Maximum="100" Foreground="{StaticResource AccentGreenBrush}" Background="#FF3B314F" BorderThickness="0" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Target: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="GoalsDailyTaskTargetBox" Height="26" Width="60" Text="3" HorizontalContentAlignment="Center" LostFocus="GoalsTarget_LostFocus"/>
                                        <TextBlock Text=" tasks/day" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Weekly Task Goal -->
                            <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="📅 Weekly Task Goal" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="GoalsWeeklyTaskProgressText" Text="0 / 15 tasks (0%)" FontSize="20" FontWeight="Bold" Foreground="#FF38BDF8" Margin="0,8,0,6"/>
                                    <ProgressBar x:Name="GoalsWeeklyTaskBar" Height="10" Value="0" Maximum="100" Foreground="#FF38BDF8" Background="#FF3B314F" BorderThickness="0" Margin="0,0,0,10"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Target: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="GoalsWeeklyTaskTargetBox" Height="26" Width="60" Text="15" HorizontalContentAlignment="Center" LostFocus="GoalsTarget_LostFocus"/>
                                        <TextBlock Text=" tasks/week" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Streak & Companion Motivation Card -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🏆" FontSize="40" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Current Habit Streak" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                        <TextBlock x:Name="GoalsStreakBigText" Text="0 Days 🔥" FontSize="22" FontWeight="Bold" Foreground="#FFFBBF24"/>
                                        <TextBlock x:Name="GoalsLongestStreakText" Text="  •  Best: 0 Days" FontSize="14" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock x:Name="GoalsCompanionMessageText" Text="Keep up the great work! Every focused minute counts." FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Goal Achievement History Section -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="📜 Goal Achievement History (Last 14 Days)" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="GoalsAchievementRateText" Text="Achievement Rate: 0%" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ItemsControl x:Name="GoalsAchievementItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" BorderBrush="#FF352C4A" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FormattedDate}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FocusStatusDisplay}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding TaskStatusDisplay}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ResultBadge}" Foreground="{Binding BadgeBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 7. AGENT ACTIVITY VIEW -->
            <Grid x:Name="AgentView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🤖 Coding Agent Activity" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <Border x:Name="AgentStatusBadge" Background="#FF2D253F" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AgentStatusBadgeText" Text="● Listening (48123)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Real-time monitoring and companion reactions for Claude Code and local coding agents."
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="AgentConfigureClaudeBtn" Content="⚙️ Claude Hooks" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="AgentConfigureClaudeBtn_Click"/>
                        <Button x:Name="AgentClearHistoryBtn" Content="🧹 Clear Completed" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="AgentClearHistoryBtn_Click"/>
                        <Button x:Name="AgentRefreshBtn" Content="🔄 Refresh" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Click="AgentRefreshBtn_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Filter Bar -->
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="AgentFilterAllBtn" Content="All (0)" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Tag="all" Click="AgentFilterBtn_Click"/>
                            <Button x:Name="AgentFilterActiveBtn" Content="Active (0)" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Tag="active" Click="AgentFilterBtn_Click"/>
                            <Button x:Name="AgentFilterWaitingBtn" Content="Waiting (0)" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Tag="waiting" Click="AgentFilterBtn_Click"/>
                            <Button x:Name="AgentFilterCompletedBtn" Content="Completed (0)" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Tag="completed" Click="AgentFilterBtn_Click"/>
                            <Button x:Name="AgentFilterFailedBtn" Content="Failed (0)" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Tag="failed" Click="AgentFilterBtn_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="AgentFilterSummaryText" Text="0 sessions tracked" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Main Content Area: Split List & Details -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sessions List -->
                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,8,0">
                        <Grid>
                            <ListBox x:Name="AgentSessionListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="AgentSessionListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF1E1A29" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Provider & Status -->
                                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                    <Border DockPanel.Dock="Left" Background="#FF2D253F" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding ProviderName}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentPurpleBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding ProjectName}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Border DockPanel.Dock="Right" Background="#FF161320" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StatusDisplayText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusBadgeColor}"/>
                                                    </Border>
                                                </DockPanel>

                                                <!-- Last Summary -->
                                                <TextBlock Grid.Row="1" Text="{Binding LastSummary}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                                <!-- Meta / Timing -->
                                                <DockPanel Grid.Row="2" LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding RelativeLastActivity}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CurrentTool}" FontSize="10" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Events.Count, StringFormat='{}{0} events'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty list placeholder -->
                            <StackPanel x:Name="AgentNoSessionsPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Visibility="Collapsed">
                                <TextBlock Text="🤖" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="No active agent sessions" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Run Claude Code with hooks enabled to observe live activity." FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,10"/>
                                <Button Content="Configure Hooks" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11" HorizontalAlignment="Center" Click="AgentConfigureClaudeBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Right: Selected Session Details & Timeline -->
                    <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <!-- Session Detail Content -->
                            <Grid x:Name="AgentSessionDetailPanel" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Session Header Card -->
                                <Border Grid.Row="0" Background="#FF1E1A29" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock x:Name="AgentDetailProjectText" Text="Workspace" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                                                <Border Background="#FF2D253F" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="AgentDetailProviderText" Text="Claude Code" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentPurpleBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="AgentDetailPathText" Text="~/workspace" FontSize="11" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="AgentDetailIdText" Text="Session ID: -" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button x:Name="AgentOpenFolderBtn" Content="📁 Open Folder" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,0,4" Click="AgentOpenFolderBtn_Click"/>
                                            <TextBlock x:Name="AgentDetailDurationText" Text="Duration: 0s" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Safe Approval Boundary Alert (Shown when waiting for input) -->
                                <Border x:Name="AgentWaitingBanner" Grid.Row="1" Background="#FF3D2615" BorderBrush="#FFD97706" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="⚠️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Content="Go to Folder" Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10" VerticalAlignment="Center" Click="AgentOpenFolderBtn_Click"/>
                                        <StackPanel>
                                            <TextBlock Text="Waiting for Confirmation in Terminal" FontSize="12" FontWeight="Bold" Foreground="#FFFBBF24"/>
                                            <TextBlock Text="Safe Approval Boundary: Approvals and inputs are processed directly in your Claude Code terminal. Neku observes events safely."
                                                       FontSize="10" Foreground="#FFFDE68A" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Timeline Header -->
                                <DockPanel Grid.Row="2" Margin="0,0,0,6">
                                    <TextBlock Text="Session Event Timeline" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock x:Name="AgentTimelineCountText" Text="0 events" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <!-- Chronological Event Timeline -->
                                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AgentEventTimelineItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FF1E1A29" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="65"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Event Icon -->
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayIcon}" FontSize="13" VerticalAlignment="Center"/>

                                                        <!-- Timestamp -->
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>

                                                        <!-- Summary & Path -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,6,0">
                                                            <TextBlock Text="{Binding Summary}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding RedactedFilePath}" FontSize="10" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- Tool or Type Pill -->
                                                        <Border Grid.Column="3" Background="#FF2D253F" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ToolName, FallbackValue='Event'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentOrangeBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>

                            <!-- No session selected placeholder -->
                            <StackPanel x:Name="AgentNoSessionSelectedPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="👈 Select a session from the list to view its activity timeline" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Modal Dialog: Claude Code Hook Setup & Diff Viewer -->
                <Grid x:Name="AgentSetupModal" Grid.Row="0" Grid.RowSpan="3" Background="#AA000000" Visibility="Collapsed">
                    <Border Background="#FF1E1A29" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Width="640" Height="500" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Modal Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="⚙️ Claude Code Integration Setup" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Content="✕" Style="{StaticResource SecondaryButton}" Padding="8,2" HorizontalAlignment="Right" Click="AgentCloseSetupModal_Click"/>
                            </DockPanel>

                            <!-- Detection Info -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock x:Name="AgentClaudeDetectedText" Text="Status: Checking..." FontSize="11" Foreground="{StaticResource AccentGreenBrush}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AgentClaudeSettingsPathText" Text="Path: ~/.claude/settings.json" FontSize="10" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" Margin="0,2,0,4"/>
                                <TextBlock Text="Proposed configuration diff to ~/.claude/settings.json (Neku creates an automatic backup before modifying and only touches its own hooks):"
                                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Diff Viewer -->
                            <Border Grid.Row="2" Background="#FF161320" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                    <TextBox x:Name="AgentDiffTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#FF93C5FD"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Action Buttons -->
                            <DockPanel Grid.Row="3">
                                <Button x:Name="AgentUninstallHooksBtn" Content="Uninstall Neku Hooks" Style="{StaticResource DangerButton}" Padding="10,5" FontSize="11" Click="AgentUninstallHooksBtn_Click"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="11" Margin="0,0,6,0" Click="AgentCloseSetupModal_Click"/>
                                    <Button x:Name="AgentApplyHooksBtn" Content="✓ Apply &amp; Install Hooks" Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="11" Click="AgentApplyHooksBtn_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 8. DEVELOPER RADAR VIEW -->
            <Grid x:Name="RadarView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📡 Developer Radar" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <Border x:Name="RadarContextBadge" Background="#FF2D253F" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="RadarContextText" Text="💻 Coding: VS Code" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPurpleBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Local workspace signals, repository status, and build telemetry."
                                   FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="RadarHudToggleBtn" Content="🪟 Floating HUD" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="RadarHudToggleBtn_Click"/>
                        <Button x:Name="RadarPauseBtn" Content="⏸ Pause" Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Click="RadarPauseBtn_Click"/>
                        <Button x:Name="RadarRefreshBtn" Content="🔄 Refresh All" Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="11" Click="RadarRefreshBtn_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Top Metric / Signal Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active App Card -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="🖥️ Active Environment" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="RadarActiveAppText" Text="Desktop" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="RadarActiveAppSubtext" Text="Category: Other" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Git Radar Card -->
                    <Border Grid.Column="1" Style="{StaticResource MetricCardBorder}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="🌿 Active Branch" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="RadarBranchText" Text="main (Clean)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="RadarRepoSubtext" Text="No repo monitored" FontSize="10" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- Build & Test Card -->
                    <Border Grid.Column="2" Style="{StaticResource MetricCardBorder}">
                        <StackPanel>
                            <TextBlock Text="⚡ Latest Build / Test" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="RadarBuildStatusText" Text="— No events" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="RadarBuildSubtext" Text="Awaiting build/test webhook" FontSize="10" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Main Radar Content: Monitored Repos & Build Log -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Monitored Repositories Panel -->
                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="📁 Monitored Git Repositories" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RadarAddRepoBtn" Content="+ Add Repo" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="RadarAddRepoBtn_Click"/>
                                    <Button x:Name="RadarRemoveRepoBtn" Content="Remove" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="11" Click="RadarRemoveRepoBtn_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Git Warning Banner (Visible if git not found) -->
                            <Border x:Name="RadarGitWarningBanner" DockPanel.Dock="Top" Background="#33FFB020" BorderBrush="#88FFB020" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8" Visibility="Collapsed">
                                <TextBlock Text="⚠️ Git CLI is not found in PATH. Repository branch and uncommitted detection are disabled, but other Neku features continue normally." FontSize="10" Foreground="#FFFFD166" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Repositories ListBox -->
                            <ListBox x:Name="RadarRepoListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     SelectionChanged="RadarRepoListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="#FF221B30" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FF2D253F"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FF29213A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{Binding Path}" FontSize="10" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#FF161320" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding DisplayStatus}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Build & Agent Activity Signals Panel -->
                    <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="⚡ Build &amp; Event Radar" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                            <!-- Quick actions for selected repo -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RadarOpenExplorerBtn" Content="📂 Explorer" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="RadarOpenExplorerBtn_Click"/>
                                    <Button x:Name="RadarCopyPathBtn" Content="📋 Copy Path" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Click="RadarCopyPathBtn_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Build Events List -->
                            <ListBox x:Name="RadarBuildListBox"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="#FF1E1A29" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#FF161320" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusBrush}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProjectName}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Message}" FontSize="10" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedTime}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 9. SYSTEM HEALTH VIEW -->
            <Grid x:Name="HealthView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Title & Controls -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💻  System Health" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="#FF2D253F" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Local-First Diagnostics" FontSize="11" Foreground="#FFA78BFA"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="HealthRefreshBtn" Content="🔄 Refresh" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,8,0" Click="HealthRefreshBtn_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Key Metrics Cards Row -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- CPU Card -->
                    <Border Grid.Column="0" Style="{StaticResource MetricCardBorder}" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="💻 CPU Load" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border x:Name="HealthCpuStatusBadge" DockPanel.Dock="Right" Background="#FF161320" CornerRadius="4" Padding="4,1">
                                    <TextBlock x:Name="HealthCpuStatusText" Text="Normal" FontSize="9" FontWeight="Bold" Foreground="#FF22C55E"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="HealthCpuPercentText" Text="0%" FontSize="22" FontWeight="Bold" Foreground="#FF38BDF8" Margin="0,4,0,2"/>
                            <ProgressBar x:Name="HealthCpuProgressBar" Height="6" Value="0" Maximum="100" Background="#FF1E1A29" Foreground="#FF38BDF8" Margin="0,4,0,2"/>
                            <TextBlock x:Name="HealthCpuThresholdText" Text="Alert at 85%" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Memory Card -->
                    <Border Grid.Column="1" Style="{StaticResource MetricCardBorder}" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="🧠 RAM Usage" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border x:Name="HealthRamStatusBadge" DockPanel.Dock="Right" Background="#FF161320" CornerRadius="4" Padding="4,1">
                                    <TextBlock x:Name="HealthRamStatusText" Text="Normal" FontSize="9" FontWeight="Bold" Foreground="#FF22C55E"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="HealthRamPercentText" Text="0%" FontSize="22" FontWeight="Bold" Foreground="#FFA78BFA" Margin="0,4,0,2"/>
                            <ProgressBar x:Name="HealthRamProgressBar" Height="6" Value="0" Maximum="100" Background="#FF1E1A29" Foreground="#FFA78BFA" Margin="0,4,0,2"/>
                            <TextBlock x:Name="HealthRamDetailText" Text="0 / 0 GB" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Primary Storage Card -->
                    <Border Grid.Column="2" Style="{StaticResource MetricCardBorder}" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="💾 Disk Free" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border x:Name="HealthDiskStatusBadge" DockPanel.Dock="Right" Background="#FF161320" CornerRadius="4" Padding="4,1">
                                    <TextBlock x:Name="HealthDiskStatusText" Text="Healthy" FontSize="9" FontWeight="Bold" Foreground="#FF22C55E"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="HealthDiskFreeText" Text="0 GB" FontSize="22" FontWeight="Bold" Foreground="#FFFBBF24" Margin="0,4,0,2"/>
                            <ProgressBar x:Name="HealthDiskProgressBar" Height="6" Value="0" Maximum="100" Background="#FF1E1A29" Foreground="#FFFBBF24" Margin="0,4,0,2"/>
                            <TextBlock x:Name="HealthDiskDetailText" Text="Drive C: 0% used" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Battery Card -->
                    <Border Grid.Column="3" Style="{StaticResource MetricCardBorder}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="🔋 Power State" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <Border x:Name="HealthPowerStatusBadge" DockPanel.Dock="Right" Background="#FF161320" CornerRadius="4" Padding="4,1">
                                    <TextBlock x:Name="HealthPowerStatusText" Text="AC" FontSize="9" FontWeight="Bold" Foreground="#FF22C55E"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="HealthBatteryPercentText" Text="100%" FontSize="22" FontWeight="Bold" Foreground="#FF34D399" Margin="0,4,0,2"/>
                            <ProgressBar x:Name="HealthBatteryProgressBar" Height="6" Value="100" Maximum="100" Background="#FF1E1A29" Foreground="#FF34D399" Margin="0,4,0,2"/>
                            <TextBlock x:Name="HealthBatteryDetailText" Text="Connected to Power" FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Detailed Split Grid: Left = Disks & Thresholds, Right = Monitored Processes -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: All Drives and Alert Settings -->
                    <Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="All Storage Drives &amp; Alerts" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl x:Name="HealthDrivesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FF161320" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <DockPanel Grid.Row="0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="11"/>
                                                            <TextBlock Text="{Binding VolumeLabel}" Foreground="{StaticResource TextDimBrush}" FontSize="10" Margin="6,0,0,0"/>
                                                            <TextBlock Text="{Binding FreeGb, StringFormat='{}{0} GB free'}" Foreground="#FFA78BFA" FontSize="10" HorizontalAlignment="Right"/>
                                                        </DockPanel>
                                                        <ProgressBar Grid.Row="1" Height="4" Margin="0,4,0,0" Value="{Binding UsedPercent}" Maximum="100" Background="#FF1E1A29" Foreground="#FF8B5CF6"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Alert Thresholds info box -->
                                    <Border Background="#FF161320" BorderBrush="#FF2E263E" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                                        <StackPanel>
                                            <TextBlock Text="🛡️ Sustained Companion Alerts" FontSize="11" FontWeight="Bold" Foreground="#FFF3E8FF" Margin="0,0,0,4"/>
                                            <TextBlock Text="• Alerts trigger after 8s of sustained load with 5% hysteresis." FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock Text="• Non-intrusive companion remarks with anti-spam cooldowns." FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock Text="• Completely local monitoring: 0 bytes transmitted externally." FontSize="10" Foreground="{StaticResource TextDimBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Right: Monitored Processes List -->
                    <Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Monitored Dev Processes" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock x:Name="HealthProcessCountText" Text="0 active" FontSize="11" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HealthProcessesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FF161320" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⚙️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ProcessName}" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                        <Border Background="#FF2D253F" CornerRadius="4" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding InstanceCount, StringFormat='{}{0} inst'}" FontSize="9" Foreground="#FFA78BFA"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding WorkingSetMb, StringFormat='{}{0} MB'}" FontSize="11" FontWeight="SemiBold" Foreground="#FF38BDF8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
