<Window x:Class="DesktopPet.UI.DeveloperHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer Radar HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        Width="350" Height="42"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Border Background="#F21E1A29"
            CornerRadius="21"
            BorderBrush="#FF8B5CF6"
            BorderThickness="1.5"
            Padding="10,4">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.45"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Context Icon & Category -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock x:Name="ContextIconText" Text="💻" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock x:Name="ContextCategoryText" Text="Coding" FontSize="11" FontWeight="Bold" Foreground="#FFF3E8FF" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 2. Repo & Branch info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                <TextBlock x:Name="RepoBranchText" Text="pixelpaws (main*)" FontSize="11" Foreground="#FFA78BFA"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 3. Build / Test Indicator -->
            <Border x:Name="BuildBadge" Grid.Column="2" Background="#FF262035" CornerRadius="10" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                <TextBlock x:Name="BuildBadgeText" Text="✔ Pass" FontSize="10" FontWeight="SemiBold" Foreground="#FF22C55E"/>
            </Border>

            <!-- 4. Active Agents Indicator -->
            <Border x:Name="AgentBadge" Grid.Column="3" Background="#FF2D253F" CornerRadius="10" Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="AgentBadgeText" Text="🤖 1" FontSize="10" FontWeight="SemiBold" Foreground="#FFFB923C"/>
            </Border>

            <!-- 5. Focus Timer mini pill -->
            <TextBlock x:Name="FocusTimerText" Grid.Column="4" Text="⏱ 25m" FontSize="11" Foreground="#FFFB923C" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>

            <!-- 6. Close button -->
            <Button x:Name="CloseButton" Grid.Column="5" Content="✕" Width="20" Height="20"
                    FontSize="10" Background="Transparent" Foreground="#FFA78BFA" BorderThickness="0"
                    Cursor="Hand" VerticalAlignment="Center" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
