<Window x:Class="DesktopPet.UI.DropzoneActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neku Dropzone"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="True"
        Width="380" Height="220"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">
    <Border Background="#F2161320"
            BorderBrush="#FF8B5CF6"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="14,12">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TypeEmojiText" Text="🐾" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Neku Dropzone" FontSize="13" FontWeight="Bold" Foreground="#FFF3E8FF" VerticalAlignment="Center"/>
                    <Border x:Name="TypeBadge" Background="#FF2D253F" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TypeBadgeText" Text="Text" FontSize="10" FontWeight="SemiBold" Foreground="#FFA78BFA"/>
                    </Border>
                </StackPanel>
                <Button x:Name="CloseButton" Content="✕" Width="20" Height="20" FontSize="10"
                        Background="Transparent" Foreground="#FFA78BFA" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </DockPanel>

            <!-- Content Preview Area -->
            <Border Grid.Row="1" Background="#FF1E1A29" BorderBrush="#FF2E263E" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PreviewTextBlock" Text="Content preview..." FontSize="11" Foreground="#DDD6FE" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- Actions Row -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="SaveNoteBtn" Grid.Column="0" Content="📝 Save Note"
                        Background="#FF7C3AED" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="11" Padding="8,6" Margin="0,0,4,0"
                        Cursor="Hand" Click="SaveNoteBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="CreateTaskBtn" Grid.Column="1" Content="📋 Create Task"
                        Background="#FF2563EB" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" FontSize="11" Padding="8,6" Margin="0,0,4,0"
                        Cursor="Hand" Click="CreateTaskBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="CopyBtn" Grid.Column="2" Content="📄 Copy"
                        Background="#FF262035" Foreground="#FFA78BFA" BorderBrush="#FF3B3050" BorderThickness="1"
                        FontSize="11" Padding="8,6"
                        Cursor="Hand" Click="CopyBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="CancelBtn" Grid.Column="3" Content="✕ Cancel"
                        Background="#FF262035" Foreground="#FF94A3B8" BorderBrush="#FF3B3050" BorderThickness="1"
                        FontSize="11" Padding="8,6" Margin="4,0,0,0"
                        Cursor="Hand" Click="CancelBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
