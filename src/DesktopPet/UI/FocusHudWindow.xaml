<Window x:Class="DesktopPet.UI.FocusHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus Timer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        Width="180" Height="40"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Border Background="#F01E1A29"
            CornerRadius="20"
            BorderBrush="#FF8B5CF6"
            BorderThickness="1.5"
            Padding="8,4">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.4"/>
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Mode Icon -->
            <TextBlock x:Name="ModeIcon" Grid.Column="0" Text="🍅" FontSize="15"
                       VerticalAlignment="Center" Margin="2,0,6,0"/>

            <!-- Timer text -->
            <TextBlock x:Name="TimeText" Grid.Column="1" Text="25:00" FontSize="14"
                       FontWeight="SemiBold" Foreground="#FFF3E8FF" VerticalAlignment="Center"
                       FontFamily="Segoe UI, Consolas"/>

            <!-- Pause/Resume button -->
            <Button x:Name="PauseButton" Grid.Column="2" Content="⏸" Width="22" Height="22"
                    FontSize="10" Background="#33FFFFFF" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Margin="4,0,2,0" Click="PauseButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="11"/>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- Close button -->
            <Button x:Name="CloseButton" Grid.Column="3" Content="✕" Width="22" Height="22"
                    FontSize="10" Background="Transparent" Foreground="#FFA78BFA" BorderThickness="0"
                    Cursor="Hand" Margin="2,0,2,0" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
