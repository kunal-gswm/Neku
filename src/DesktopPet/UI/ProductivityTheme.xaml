<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">

    <!-- =========================================================================
         1. COLOR DESIGN TOKENS
         ========================================================================= -->

    <!-- Surfaces & Backgrounds -->
    <Color x:Key="ColorThemeBg">#FF161320</Color>
    <Color x:Key="ColorThemeSurface">#FF1E1A29</Color>
    <Color x:Key="ColorThemeCardBg">#FF262035</Color>
    <Color x:Key="ColorThemeElevated">#FF2D253F</Color>
    <Color x:Key="ColorThemeInputBg">#FF221B30</Color>
    <Color x:Key="ColorThemeInputBgHover">#FF29213A</Color>
    <Color x:Key="ColorThemePopupBg">#FF1D182A</Color>

    <!-- Borders -->
    <Color x:Key="ColorThemeBorder">#FF382F4A</Color>
    <Color x:Key="ColorThemeBorderSubtle">#FF2A2338</Color>
    <Color x:Key="ColorThemeInputBorder">#FF43365C</Color>
    <Color x:Key="ColorThemeInputBorderHover">#FF635185</Color>
    <Color x:Key="ColorThemeInputBorderFocused">#FF8B5CF6</Color>

    <!-- Accents -->
    <Color x:Key="ColorThemeAccentPurple">#FF8B5CF6</Color>
    <Color x:Key="ColorThemeAccentPurpleHover">#FF9F75FF</Color>
    <Color x:Key="ColorThemeAccentPurplePressed">#FF7C3AED</Color>
    <Color x:Key="ColorThemeAccentOrange">#FFFB923C</Color>
    <Color x:Key="ColorThemeAccentOrangeHover">#FFF97316</Color>
    <Color x:Key="ColorThemeAccentGreen">#FF22C55E</Color>
    <Color x:Key="ColorThemeAccentRed">#FFEF4444</Color>

    <!-- Danger/Destructive Actions -->
    <Color x:Key="ColorThemeDangerBg">#FF421C22</Color>
    <Color x:Key="ColorThemeDangerBorder">#FF70222B</Color>
    <Color x:Key="ColorThemeDangerHover">#FF59222A</Color>
    <Color x:Key="ColorThemeDangerText">#FFFCA5A5</Color>

    <!-- Typography Text -->
    <Color x:Key="ColorThemeTextPrimary">#FFF3E8FF</Color>
    <Color x:Key="ColorThemeTextSecondary">#FFA78BFA</Color>
    <Color x:Key="ColorThemeTextDim">#FF9CA3AF</Color>
    <Color x:Key="ColorThemeTextMuted">#FF716488</Color>

    <!-- Selection & Scrollbars -->
    <Color x:Key="ColorThemeSelection">#FF452C63</Color>
    <Color x:Key="ColorThemeSelectionHover">#FF36244E</Color>
    <Color x:Key="ColorThemeScrollTrack">#FF181424</Color>
    <Color x:Key="ColorThemeScrollThumb">#FF3B3150</Color>
    <Color x:Key="ColorThemeScrollThumbHover">#FF564775</Color>
    <Color x:Key="ColorThemeScrollThumbPressed">#FF7C3AED</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ThemeBgBrush" Color="{StaticResource ColorThemeBg}"/>
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{StaticResource ColorThemeSurface}"/>
    <SolidColorBrush x:Key="ThemeCardBgBrush" Color="{StaticResource ColorThemeCardBg}"/>
    <SolidColorBrush x:Key="ThemeElevatedBrush" Color="{StaticResource ColorThemeElevated}"/>
    <SolidColorBrush x:Key="ThemeInputBgBrush" Color="{StaticResource ColorThemeInputBg}"/>
    <SolidColorBrush x:Key="ThemeInputBgHoverBrush" Color="{StaticResource ColorThemeInputBgHover}"/>
    <SolidColorBrush x:Key="ThemePopupBgBrush" Color="{StaticResource ColorThemePopupBg}"/>

    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ColorThemeBorder}"/>
    <SolidColorBrush x:Key="ThemeBorderSubtleBrush" Color="{StaticResource ColorThemeBorderSubtle}"/>
    <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="{StaticResource ColorThemeInputBorder}"/>
    <SolidColorBrush x:Key="ThemeInputBorderHoverBrush" Color="{StaticResource ColorThemeInputBorderHover}"/>
    <SolidColorBrush x:Key="ThemeInputBorderFocusedBrush" Color="{StaticResource ColorThemeInputBorderFocused}"/>

    <SolidColorBrush x:Key="ThemeAccentPurpleBrush" Color="{StaticResource ColorThemeAccentPurple}"/>
    <SolidColorBrush x:Key="ThemeAccentPurpleHoverBrush" Color="{StaticResource ColorThemeAccentPurpleHover}"/>
    <SolidColorBrush x:Key="ThemeAccentPurplePressedBrush" Color="{StaticResource ColorThemeAccentPurplePressed}"/>
    <SolidColorBrush x:Key="ThemeAccentOrangeBrush" Color="{StaticResource ColorThemeAccentOrange}"/>
    <SolidColorBrush x:Key="ThemeAccentOrangeHoverBrush" Color="{StaticResource ColorThemeAccentOrangeHover}"/>
    <SolidColorBrush x:Key="ThemeAccentGreenBrush" Color="{StaticResource ColorThemeAccentGreen}"/>
    <SolidColorBrush x:Key="ThemeAccentRedBrush" Color="{StaticResource ColorThemeAccentRed}"/>

    <SolidColorBrush x:Key="ThemeDangerBgBrush" Color="{StaticResource ColorThemeDangerBg}"/>
    <SolidColorBrush x:Key="ThemeDangerBorderBrush" Color="{StaticResource ColorThemeDangerBorder}"/>
    <SolidColorBrush x:Key="ThemeDangerHoverBrush" Color="{StaticResource ColorThemeDangerHover}"/>
    <SolidColorBrush x:Key="ThemeDangerTextBrush" Color="{StaticResource ColorThemeDangerText}"/>

    <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ColorThemeTextPrimary}"/>
    <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="{StaticResource ColorThemeTextSecondary}"/>
    <SolidColorBrush x:Key="ThemeTextDimBrush" Color="{StaticResource ColorThemeTextDim}"/>
    <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="{StaticResource ColorThemeTextMuted}"/>

    <SolidColorBrush x:Key="ThemeSelectionBrush" Color="{StaticResource ColorThemeSelection}"/>
    <SolidColorBrush x:Key="ThemeSelectionHoverBrush" Color="{StaticResource ColorThemeSelectionHover}"/>
    <SolidColorBrush x:Key="ThemeScrollTrackBrush" Color="{StaticResource ColorThemeScrollTrack}"/>
    <SolidColorBrush x:Key="ThemeScrollThumbBrush" Color="{StaticResource ColorThemeScrollThumb}"/>
    <SolidColorBrush x:Key="ThemeScrollThumbHoverBrush" Color="{StaticResource ColorThemeScrollThumbHover}"/>
    <SolidColorBrush x:Key="ThemeScrollThumbPressedBrush" Color="{StaticResource ColorThemeScrollThumbPressed}"/>

    <!-- Backward-compatible legacy aliases -->
    <SolidColorBrush x:Key="RailBgBrush" Color="{StaticResource ColorThemeSurface}"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource ColorThemeCardBg}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource ColorThemeBorder}"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource ColorThemeInputBg}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource ColorThemeAccentPurple}"/>
    <SolidColorBrush x:Key="AccentPurpleHoverBrush" Color="{StaticResource ColorThemeAccentPurpleHover}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource ColorThemeAccentOrange}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource ColorThemeAccentGreen}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorThemeTextSecondary}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource ColorThemeTextDim}"/>


    <!-- =========================================================================
         2. SCROLLBAR & SCROLLVIEWER STYLES
         ========================================================================= -->

    <Style x:Key="ScrollBarThumbVertical" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{StaticResource ThemeScrollThumbBrush}"
                            CornerRadius="4"
                            Margin="2,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ThemeScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="{StaticResource ThemeScrollThumbPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbHorizontal" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{StaticResource ThemeScrollThumbBrush}"
                            CornerRadius="4"
                            Margin="0,2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ThemeScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="{StaticResource ThemeScrollThumbPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{StaticResource ThemeScrollTrackBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="{StaticResource ThemeScrollTrackBrush}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbVertical}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="{StaticResource ThemeScrollTrackBrush}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Focusable="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbHorizontal}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- =========================================================================
         3. TEXTBOX & INPUT CONTROLS
         ========================================================================= -->

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{StaticResource ThemeInputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CaretBrush" Value="{StaticResource ThemeAccentPurpleBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource ThemeSelectionBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalScrollBarVisibility" Value="Auto"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ThemeInputBorderHoverBrush}"/>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeInputBgHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ThemeInputBorderFocusedBrush}"/>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeInputBgBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =========================================================================
         4. CHECKBOX STYLE
         ========================================================================= -->

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Box -->
                        <Border x:Name="checkBorder"
                                Grid.Column="0"
                                Width="16" Height="16"
                                Background="{StaticResource ThemeInputBgBrush}"
                                BorderBrush="{StaticResource ThemeInputBorderBrush}"
                                BorderThickness="1.2"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <!-- Checkmark Glyphs -->
                            <Path x:Name="checkMark"
                                  Data="M 3 8 L 6.5 11.5 L 13 4"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Border>

                        <!-- Content -->
                        <ContentPresenter Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Checked State -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkBorder" Property="Background" Value="{StaticResource ThemeAccentPurpleBrush}"/>
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentPurpleBrush}"/>
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Mouse Over Unchecked -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentPurpleHoverBrush}"/>
                            <Setter TargetName="checkBorder" Property="Background" Value="{StaticResource ThemeInputBgHoverBrush}"/>
                        </MultiTrigger>
                        <!-- Mouse Over Checked -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="checkBorder" Property="Background" Value="{StaticResource ThemeAccentPurpleHoverBrush}"/>
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentPurpleHoverBrush}"/>
                        </MultiTrigger>
                        <!-- Focused -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="checkBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentPurpleHoverBrush}"/>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =========================================================================
         5. BUTTON STYLES
         ========================================================================= -->

    <!-- Base / Primary Purple Button -->
    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource ThemeAccentPurpleBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeAccentPurpleHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeAccentPurplePressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Accent Button -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}"/>

    <!-- Secondary Outline Button -->
    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource ThemeInputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeElevatedBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ThemeInputBorderHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeSelectionBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Warm Orange Action Button -->
    <Style x:Key="OrangeButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource ThemeAccentOrangeBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeAccentOrangeHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFE05307"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource ThemeDangerBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeDangerTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeDangerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeDangerHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF35151B"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation Rail Button -->
    <Style x:Key="NavRailButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Margin="4,2"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FF2B243B"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter Chip Button -->
    <Style x:Key="FilterChipButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource ThemeInputBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextDimBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeElevatedBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =========================================================================
         6. COMBOBOX STYLE (COMPREHENSIVE DARK POPUP & CONTROLS)
         ========================================================================= -->

    <!-- ToggleButton for ComboBox -->
    <Style x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="border"
                            Background="{StaticResource ThemeInputBgBrush}"
                            BorderBrush="{StaticResource ThemeInputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <!-- Chevron Arrow -->
                            <Path x:Name="arrow"
                                  Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{StaticResource ThemeTextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ThemeInputBorderHoverBrush}"/>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeInputBgHoverBrush}"/>
                            <Setter TargetName="arrow" Property="Stroke" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ThemeInputBorderFocusedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem Style -->
    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="itemBorder"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="8,5"
                            Margin="2,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource ThemeSelectionHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource ThemeSelectionBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global ComboBox Style -->
    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource ThemeInputBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                        <!-- Toggle Button (Closed Appearance) -->
                        <ToggleButton x:Name="ToggleButton"
                                      Style="{StaticResource ComboBoxToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <!-- Selected Content Display -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="8,3,24,3"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                        <!-- Dropdown Popup -->
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                    MaxHeight="260"
                                    Background="{StaticResource ThemePopupBgBrush}"
                                    BorderBrush="{StaticResource ThemeInputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="2"
                                    Margin="0,3,0,6">
                                <ScrollViewer x:Name="DropDownScrollViewer">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="32"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =========================================================================
         7. DATEPICKER & CALENDAR STYLES (THEMED DARK DIALOGS)
         ========================================================================= -->

    <!-- DatePickerTextBox Style -->
    <Style TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CaretBrush" Value="{StaticResource ThemeAccentPurpleBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarDayButton Style -->
    <Style TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Border x:Name="dayBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Today Indicator -->
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="dayBorder" Property="BorderBrush" Value="{StaticResource ThemeAccentOrangeBrush}"/>
                            <Setter TargetName="dayBorder" Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource ThemeAccentOrangeBrush}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dayBorder" Property="Background" Value="{StaticResource ThemeSelectionHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="dayBorder" Property="Background" Value="{StaticResource ThemeAccentPurpleBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <!-- Inactive Day (Out of month) -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource ThemeTextMutedBrush}"/>
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.25"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendar Month/Decade Button Style -->
    <Style TargetType="{x:Type CalendarButton}">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Border x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Margin="2"
                            Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource ThemeSelectionHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource ThemeAccentPurpleBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global CalendarItem Style (Header, Arrows, Day Names, Dark Popup) -->
    <Style TargetType="{x:Type primitives:CalendarItem}">
        <Setter Property="Background" Value="{StaticResource ThemePopupBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:CalendarItem}">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static primitives:CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}"
                                       Foreground="{StaticResource ThemeTextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,3,0,3"/>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="6">
                        <Grid x:Name="PART_Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Month / Year Navigation Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_PreviousButton"
                                        Grid.Column="0"
                                        Width="26" Height="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="Transparent" CornerRadius="4">
                                                <Path Data="M 6 0 L 2 4 L 6 8"
                                                      Stroke="{StaticResource ThemeTextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <primitives:CalendarButton x:Name="PART_HeaderButton"
                                                           Grid.Column="1"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Foreground="{StaticResource ThemeTextPrimaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                <Button x:Name="PART_NextButton"
                                        Grid.Column="2"
                                        Width="26" Height="24"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="Transparent" CornerRadius="4">
                                                <Path Data="M 2 0 L 6 4 L 2 8"
                                                      Stroke="{StaticResource ThemeTextSecondaryBrush}"
                                                      StrokeThickness="1.5"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Month View Grid -->
                            <Grid x:Name="PART_MonthView"
                                  Grid.Row="1"
                                  Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            </Grid>

                            <!-- Year / Decade View Grid -->
                            <Grid x:Name="PART_YearView"
                                  Grid.Row="1"
                                  Visibility="Hidden">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global Calendar Style -->
    <Style TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{StaticResource ThemePopupBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="CalendarItemStyle" Value="{StaticResource {x:Type primitives:CalendarItem}}"/>
    </Style>

    <!-- Global DatePicker Style -->
    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource ThemeInputBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="CalendarStyle" Value="{StaticResource {x:Type Calendar}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="2,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               HorizontalContentAlignment="Stretch"
                                               VerticalContentAlignment="Center"/>

                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Width="24" Height="22"
                                    Margin="0,1,2,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="Transparent" CornerRadius="4">
                                            <Path Data="M 1 3 L 11 3 M 3 1 L 3 3 M 9 1 L 9 3 M 1 2 C 1 1.45 1.45 1 2 1 L 10 1 C 10.55 1 11 1.45 11 2 L 11 10 C 11 10.55 10.55 11 10 11 L 2 11 C 1.45 11 1 10.55 1 10 Z"
                                                  Stroke="{StaticResource ThemeTextSecondaryBrush}"
                                                  StrokeThickness="1.2"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=border}"
                                   StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ThemeInputBorderHoverBrush}"/>
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeInputBgHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- =========================================================================
         8. LISTBOX & SELECTION STYLES
         ========================================================================= -->

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeSelectionHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeSelectionBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ThemeAccentPurpleBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource ThemeCardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>


    <!-- =========================================================================
         9. DATAGRID STYLES
         ========================================================================= -->

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{StaticResource ThemeCardBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemeSelectionHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ThemeSelectionBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{StaticResource ThemeCardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="RowBackground" Value="#FF231D31"/>
        <Setter Property="AlternatingRowBackground" Value="#FF282138"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ThemeBorderSubtleBrush}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>


    <!-- =========================================================================
         10. PROGRESSBAR, TOOLTIP & CARDS
         ========================================================================= -->

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="8"/>
        <Setter Property="Background" Value="#FF1E182B"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeAccentPurpleBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="TemplateRoot">
                            <Border x:Name="PART_Track" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource ThemeCardBgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Global TabControl & TabItem Styles (Dark Theme) -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0"
                                  IsItemsHost="True"
                                  Margin="0,0,0,2"/>
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,6,6,6">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{StaticResource ThemeTextDimBrush}"/>
        <Setter Property="Background" Value="{StaticResource ThemeBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,1,1,0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,0,0"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,0,2,0"
                            Cursor="Hand">
                        <ContentPresenter x:Name="header"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeElevatedBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ThemeSurfaceBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ThemeAccentPurpleBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource ThemeAccentPurpleBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Border Panel Style -->
    <Style x:Key="MetricCardBorder" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource ThemeCardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="4"/>
    </Style>

</ResourceDictionary>
