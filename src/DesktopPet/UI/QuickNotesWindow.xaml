<Window x:Class="DesktopPet.UI.QuickNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neku Notes"
        Width="540" Height="390"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1A29"
        Foreground="#FFF3E8FF"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF282337"/>
            <Setter Property="Foreground" Value="#FFF3E8FF"/>
            <Setter Property="BorderBrush" Value="#FF483C66"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#FFA78BFA"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF8B5CF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF9F75FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" MinWidth="130" MaxWidth="250"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Search, List, New button -->
        <DockPanel Grid.Column="0">
            <Button x:Name="NewNoteBtn" DockPanel.Dock="Bottom" Content="+ New Note" Margin="0,8,0,0"
                    Click="NewNoteBtn_Click"/>

            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Filter notes by title or content"/>

            <ListBox x:Name="NotesListBox"
                     Background="#FF282337"
                     BorderBrush="#FF483C66"
                     Foreground="#FFF3E8FF"
                     SelectionChanged="NotesListBox_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="#FFF3E8FF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding FormattedDate}" FontSize="10"
                                       Foreground="#FFA78BFA" Margin="0,1,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- Right: Editor -->
        <DockPanel Grid.Column="2">
            <!-- Header: Title and Save/Delete buttons -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TitleBox" Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                         TextChanged="Editor_TextChanged" Margin="0,0,6,0"
                         ToolTip="Note Title"/>

                <Button x:Name="SaveBtn" Grid.Column="1" Content="💾 Save" Margin="0,0,6,0"
                        Click="SaveBtn_Click"/>

                <Button x:Name="DeleteBtn" Grid.Column="2" Content="🗑" Background="#FFB91C1C"
                        ToolTip="Delete Note" Click="DeleteBtn_Click"/>
            </Grid>

            <!-- Status bar -->
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="Ready"
                       FontSize="10" Foreground="#FFA78BFA" Margin="2,4,0,0"/>

            <!-- Main note content -->
            <TextBox x:Name="ContentBox" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="12" TextChanged="Editor_TextChanged"/>
        </DockPanel>
    </Grid>
</Window>
