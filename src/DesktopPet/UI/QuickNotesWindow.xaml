<Window x:Class="DesktopPet.UI.QuickNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neku Notes"
        Width="540" Height="390"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1A29"
        Foreground="#FFF3E8FF"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProductivityTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" MinWidth="130" MaxWidth="250"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Search, List, New button -->
        <DockPanel Grid.Column="0">
            <Button x:Name="NewNoteBtn" DockPanel.Dock="Bottom" Content="+ New Note" Margin="0,8,0,0"
                    Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="Create New Note"
                    Click="NewNoteBtn_Click"/>

            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                     TextChanged="SearchBox_TextChanged"
                     ToolTip="Filter notes by title or content"
                     AutomationProperties.Name="Search Notes"/>

            <Grid>
                <ListBox x:Name="NotesListBox"
                         Background="{StaticResource ThemeInputBgBrush}"
                         BorderBrush="{StaticResource ThemeBorderBrush}"
                         Foreground="{StaticResource ThemeTextPrimaryBrush}"
                         SelectionChanged="NotesListBox_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Notes List">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{StaticResource ThemeTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding FormattedDate}" FontSize="10"
                                           Foreground="{StaticResource ThemeTextSecondaryBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State Message -->
                <Border x:Name="EmptyNotesBorder" Background="{StaticResource ThemeInputBgBrush}"
                        BorderBrush="{StaticResource ThemeBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Visibility="Collapsed" Padding="12">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📝" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="No notes found" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{StaticResource ThemeTextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click + New Note to add one" FontSize="10"
                                   Foreground="{StaticResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- Right: Editor -->
        <DockPanel Grid.Column="2">
            <!-- Header: Title and Save/Delete buttons -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TitleBox" Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                         TextChanged="Editor_TextChanged" Margin="0,0,6,0"
                         ToolTip="Note Title"
                         AutomationProperties.Name="Note Title"/>

                <Button x:Name="SaveBtn" Grid.Column="1" Content="💾 Save" Margin="0,0,6,0"
                        Style="{StaticResource PrimaryButton}"
                        AutomationProperties.Name="Save Note"
                        Click="SaveBtn_Click"/>

                <Button x:Name="DeleteBtn" Grid.Column="2" Content="🗑" Width="30"
                        Style="{StaticResource DangerButton}"
                        ToolTip="Delete Note"
                        AutomationProperties.Name="Delete Note"
                        Click="DeleteBtn_Click"/>
            </Grid>

            <!-- Status bar -->
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="Ready"
                       FontSize="10" Foreground="{StaticResource ThemeTextSecondaryBrush}" Margin="2,4,0,0"/>

            <!-- Main note content -->
            <TextBox x:Name="ContentBox" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontSize="12" TextChanged="Editor_TextChanged"
                     AutomationProperties.Name="Note Content"/>
        </DockPanel>
    </Grid>
</Window>
