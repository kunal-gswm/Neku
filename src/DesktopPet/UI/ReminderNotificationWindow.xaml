<Window x:Class="DesktopPet.UI.ReminderNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neku Reminder"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        Width="390" Height="108"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown">
    <Border Background="#FF1E1A29"
            CornerRadius="14"
            BorderBrush="#FF8B5CF6"
            BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect Color="#2E1065" BlurRadius="14" ShadowDepth="3" Opacity="0.5"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       Text="⏰"
                       FontSize="26"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <!-- Content Area -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="Task Title"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#FFF3E8FF"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock x:Name="SubText"
                           Text="Scheduled reminder"
                           FontSize="11"
                           Foreground="#FFA78BFA"
                           Margin="0,2,0,8"
                           TextTrimming="CharacterEllipsis"/>
                
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CompleteButton"
                            Content="✓ Done"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Padding="8,3"
                            Background="#FF22C55E"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,6,0"
                            Click="CompleteButton_Click"
                            AutomationProperties.Name="Complete Task">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="SnoozeButton"
                            Content="💤 Snooze (15m)"
                            FontSize="11"
                            Padding="8,3"
                            Background="#FF382F4A"
                            Foreground="#FFF3E8FF"
                            BorderThickness="1"
                            BorderBrush="#FF52436D"
                            Cursor="Hand"
                            Margin="0,0,6,0"
                            Click="SnoozeButton_Click"
                            AutomationProperties.Name="Snooze Reminder">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="DismissButton"
                            Content="Dismiss"
                            FontSize="11"
                            Padding="8,3"
                            Background="Transparent"
                            Foreground="#FF9CA3AF"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="DismissButton_Click"
                            AutomationProperties.Name="Dismiss Reminder"/>
                </StackPanel>
            </StackPanel>

            <!-- Close (Dismiss) Button -->
            <Button Grid.Column="2"
                    Content="✕"
                    Width="24" Height="24"
                    FontSize="12"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#FF9CA3AF"
                    Cursor="Hand"
                    Click="DismissButton_Click"
                    AutomationProperties.Name="Close Notification"/>
        </Grid>
    </Border>
</Window>
