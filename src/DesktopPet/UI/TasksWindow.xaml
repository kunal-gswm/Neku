<Window x:Class="DesktopPet.UI.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neku Tasks"
        Width="740" Height="500"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1A29"
        Foreground="#FFF3E8FF"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProductivityTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource FilterChipButton}"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12" Background="{StaticResource ThemeSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="260" MaxWidth="440"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Pane: Navigation views, Search/Sort, Task List -->
        <DockPanel Grid.Column="0">
            <!-- Hub Quick Switch Button -->
            <Button DockPanel.Dock="Top" x:Name="OpenHubBtn" AutomationProperties.Name="Open Productivity Hub" Content="🐾 Open Productivity Hub →"
                    Style="{StaticResource SecondaryButton}" Height="28" Margin="0,0,0,8" Padding="6,4"
                    Click="OpenHubBtn_Click" ToolTip="Open the full Productivity Hub with Analytics &amp; Goals"/>

            <!-- View Tabs -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="TodayTabBtn" AutomationProperties.Name="Today Tasks Filter" Grid.Column="0" Content="☀️ Today" Style="{StaticResource TabButton}"
                        Margin="0,0,3,0" Click="TabBtn_Click" Tag="Today"/>
                <Button x:Name="UpcomingTabBtn" AutomationProperties.Name="Upcoming Tasks Filter" Grid.Column="1" Content="📅 Upcoming" Style="{StaticResource TabButton}"
                        Margin="2,0,3,0" Click="TabBtn_Click" Tag="Upcoming"/>
                <Button x:Name="AllTabBtn" AutomationProperties.Name="All Tasks Filter" Grid.Column="2" Content="📋 All" Style="{StaticResource TabButton}"
                        Margin="2,0,3,0" Click="TabBtn_Click" Tag="All"/>
                <Button x:Name="CompletedTabBtn" AutomationProperties.Name="Completed Tasks Filter" Grid.Column="3" Content="✅ Done" Style="{StaticResource TabButton}"
                        Margin="2,0,0,0" Click="TabBtn_Click" Tag="Completed"/>
            </Grid>

            <!-- Search and Sort Bar -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" AutomationProperties.Name="Search Tasks" Grid.Column="0" Height="28" Margin="0,0,6,0"
                         TextChanged="SearchBox_TextChanged"
                         ToolTip="Search tasks by title or description (Ctrl+F)"/>
                <ComboBox x:Name="SortCombo" AutomationProperties.Name="Sort Tasks" Grid.Column="1" Height="28" SelectionChanged="SortCombo_SelectionChanged"
                          ToolTip="Sort task list">
                    <ComboBoxItem Content="Due Date" IsSelected="True"/>
                    <ComboBoxItem Content="Priority"/>
                    <ComboBoxItem Content="Newest"/>
                    <ComboBoxItem Content="Title"/>
                </ComboBox>
            </Grid>

            <!-- Inline Quick Task Entry -->
            <Border DockPanel.Dock="Top" Background="#FF231E30" BorderBrush="#FF483C66" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="QuickTaskBox" BorderThickness="0" Background="Transparent" Foreground="White"
                             VerticalContentAlignment="Center" Padding="4,2" FontSize="12"
                             AutomationProperties.Name="Quick Task Input"
                             Text="Add a task quickly... (press Enter)"
                             GotFocus="QuickTaskBox_GotFocus" LostFocus="QuickTaskBox_LostFocus" KeyDown="QuickTaskBox_KeyDown"/>
                    <Button x:Name="QuickAddBtn" Grid.Column="1" Content="+ Add" Style="{StaticResource SecondaryButton}"
                            Padding="8,2" FontSize="11" Margin="4,0,0,0" Click="QuickAddBtn_Click" AutomationProperties.Name="Quick Add Task"/>
                </Grid>
            </Border>

            <!-- Bottom: New Task button -->
            <Button x:Name="NewTaskBtn" AutomationProperties.Name="Create New Task" DockPanel.Dock="Bottom" Content="+ New Task (Ctrl+N)"
                    Margin="0,8,0,0" Click="NewTaskBtn_Click"/>

            <!-- Task List and Empty State container -->
            <Grid>
                <ListBox x:Name="TasksListBox" AutomationProperties.Name="Tasks List"
                         Background="#FF282337"
                         BorderBrush="#FF483C66"
                         Foreground="#FFF3E8FF"
                         SelectionChanged="TasksListBox_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FF3B314F" BorderThickness="0,0,0,1" Padding="4,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Quick toggle completion checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                              Click="TaskItemCheck_Click"/>

                                    <StackPanel Grid.Column="1">
                                        <!-- Title -->
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="#FFF3E8FF" TextTrimming="CharacterEllipsis"/>

                                        <!-- Sub-row: Priority, Due Date, Pomodoros -->
                                        <WrapPanel Margin="0,3,0,0">
                                            <!-- Priority badge -->
                                            <Border Background="#FF3B2D54" CornerRadius="3" Padding="4,1" Margin="0,0,4,2">
                                                <TextBlock Text="{Binding PriorityDisplay}" FontSize="9"
                                                           Foreground="#FFA78BFA" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Due Date badge -->
                                            <Border Background="#FF1E293B" CornerRadius="3" Padding="4,1" Margin="0,0,4,2">
                                                <TextBlock Text="{Binding FormattedDueDate}" FontSize="9"
                                                           Foreground="#FF38BDF8"/>
                                            </Border>
                                            <Border Visibility="{Binding HasReminder, Converter={StaticResource BoolToVis}}"
                                                    Background="#FF2E1065" CornerRadius="3" Padding="4,1" Margin="0,0,4,2">
                                                <TextBlock Text="{Binding FormattedReminder, StringFormat='⏰ {0}'}" FontSize="9"
                                                           Foreground="#FFC084FC"/>
                                            </Border>

                                            <!-- Pomodoro count badge -->
                                            <Border Background="#FF451A03" CornerRadius="3" Padding="4,1" Margin="0,0,4,2">
                                                <TextBlock Text="{Binding PomodoroDisplay}" FontSize="9"
                                                           Foreground="#FFFDBA74"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State Message -->
                <Border x:Name="EmptyStateBorder" Background="#FF282337" BorderBrush="#FF483C66"
                        BorderThickness="1" CornerRadius="4" Visibility="Collapsed" Padding="16">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="EmptyStateIcon" Text="📝" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock x:Name="EmptyStateTitle" Text="No tasks found" FontWeight="SemiBold" FontSize="13"
                                   Foreground="#FFF3E8FF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyStateSubtitle" Text="Click + New Task to create one" FontSize="11"
                                   Foreground="#FFA78BFA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- Right Pane: Task Detail & Editor -->
        <Grid Grid.Column="2">
            <!-- Selected Task Editor -->
            <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                <!-- Top Toolbar: Completion toggle, Focus button, Delete button -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="DetailCompleteCheck" AutomationProperties.Name="Mark Task Completed" Grid.Column="0" Content="Mark Completed"
                              VerticalAlignment="Center" Click="DetailCompleteCheck_Click"/>

                    <Button x:Name="StartFocusBtn" AutomationProperties.Name="Start Focus Session" Grid.Column="2" Content="🎯 Start Focus (25m)"
                            Margin="0,0,6,0" Click="StartFocusBtn_Click"
                            ToolTip="Start a Pomodoro focus session on this task"/>

                    <Button x:Name="DeleteTaskBtn" Grid.Column="3" Content="🗑" Width="30"
                            Style="{StaticResource DangerButton}"
                            Click="DeleteTaskBtn_Click" ToolTip="Delete Task"
                            AutomationProperties.Name="Delete Task"/>
                </Grid>

                <!-- Title Box -->
                <TextBox x:Name="TitleBox" AutomationProperties.Name="Task Title" DockPanel.Dock="Top" FontSize="14" FontWeight="SemiBold"
                         Margin="0,0,0,8" TextChanged="TitleBox_TextChanged" ToolTip="Task Title"/>

                <!-- Metadata Row: Priority, Due Date, Est. Minutes -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Priority -->
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Priority:" FontSize="10" Foreground="#FFA78BFA" Margin="0,0,0,2"/>
                        <ComboBox x:Name="PriorityCombo" AutomationProperties.Name="Task Priority" SelectionChanged="PriorityCombo_SelectionChanged">
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Normal" IsSelected="True"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Urgent 🔥"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Due Date -->
                    <StackPanel Grid.Column="1" Margin="2,0,4,0">
                        <TextBlock Text="Due Date:" FontSize="10" Foreground="#FFA78BFA" Margin="0,0,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DueDatePicker" AutomationProperties.Name="Task Due Date" Grid.Column="0" SelectedDateChanged="DueDatePicker_SelectedDateChanged"/>
                            <Button x:Name="ClearDueDateBtn" Grid.Column="1" Content="✕" Width="22" Background="#FF3B314F"
                                    Margin="2,0,0,0" Click="ClearDueDateBtn_Click" ToolTip="Clear Due Date"/>
                        </Grid>
                    </StackPanel>

                    <!-- Estimated Minutes -->
                    <StackPanel Grid.Column="2" Margin="2,0,0,0">
                        <TextBlock Text="Estimate:" FontSize="10" Foreground="#FFA78BFA" Margin="0,0,0,2"/>
                        <ComboBox x:Name="EstMinutesCombo" AutomationProperties.Name="Task Estimate Minutes" SelectionChanged="EstMinutesCombo_SelectionChanged">
                            <ComboBoxItem Content="None (0m)" Tag="0" IsSelected="True"/>
                            <ComboBoxItem Content="25m (1 🍅)" Tag="25"/>
                            <ComboBoxItem Content="50m (2 🍅)" Tag="50"/>
                            <ComboBoxItem Content="75m (3 🍅)" Tag="75"/>
                            <ComboBoxItem Content="100m (4 🍅)" Tag="100"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Reminder Row -->
                <Border DockPanel.Dock="Top" Background="#FF231E30" BorderBrush="#FF483C66" BorderThickness="1"
                        CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Label / Status -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏰" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reminder:" FontSize="11" FontWeight="SemiBold" Foreground="#FFF3E8FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ReminderStatusText" Text="None" FontSize="11" Foreground="#FFA78BFA" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Quick Presets -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="Remind5mBtn" Content="+5m" Style="{StaticResource FilterChipButton}"
                                    Padding="6,2" FontSize="10" Margin="0,0,3,0" Click="RemindPreset_Click" Tag="5"
                                    AutomationProperties.Name="Remind in 5 minutes"/>
                            <Button x:Name="Remind15mBtn" Content="+15m" Style="{StaticResource FilterChipButton}"
                                    Padding="6,2" FontSize="10" Margin="0,0,3,0" Click="RemindPreset_Click" Tag="15"
                                    AutomationProperties.Name="Remind in 15 minutes"/>
                            <Button x:Name="Remind1hBtn" Content="+1h" Style="{StaticResource FilterChipButton}"
                                    Padding="6,2" FontSize="10" Margin="0,0,3,0" Click="RemindPreset_Click" Tag="60"
                                    AutomationProperties.Name="Remind in 1 hour"/>
                            <Button x:Name="RemindLaterBtn" Content="Later Today" Style="{StaticResource FilterChipButton}"
                                    Padding="6,2" FontSize="10" Margin="0,0,4,0" Click="RemindPreset_Click" Tag="Later"
                                    AutomationProperties.Name="Remind later today"/>
                        </StackPanel>

                        <!-- Clear Reminder Button -->
                        <Button x:Name="ClearReminderBtn" Grid.Column="2" Content="✕" Width="20" Height="20"
                                Style="{StaticResource DangerButton}" Padding="0" FontSize="10"
                                Click="ClearReminderBtn_Click" ToolTip="Clear reminder"
                                AutomationProperties.Name="Clear Task Reminder"/>
                    </Grid>
                </Border>

                <!-- Pomodoro Completed Sessions Stats -->
                <Border DockPanel.Dock="Top" Background="#FF282337" BorderBrush="#FF483C66" BorderThickness="1"
                        CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="PomodoroStatsText" Text="🍅 0 focus sessions completed on this task"
                               FontSize="11" Foreground="#FFFDBA74"/>
                </Border>

                <!-- Description / Notes Label -->
                <TextBlock DockPanel.Dock="Top" Text="Description &amp; Notes:" FontSize="11"
                           Foreground="#FFA78BFA" Margin="0,0,0,4"/>

                <!-- Description Box -->
                <TextBox x:Name="DescriptionBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         TextChanged="DescriptionBox_TextChanged"
                         ToolTip="Detailed task notes or checklist items"/>
            </DockPanel>

            <!-- No Selection Placeholder -->
            <Border x:Name="NoSelectionBorder" Background="#FF282337" BorderBrush="#FF483C66"
                    BorderThickness="1" CornerRadius="6" Padding="20">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Select a task to view details" FontWeight="SemiBold" FontSize="14"
                               Foreground="#FFF3E8FF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Or press + New Task (Ctrl+N) to create one" FontSize="11"
                               Foreground="#FFA78BFA" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
